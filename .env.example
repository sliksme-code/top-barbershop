# Скопировать в .env на сервере (/opt/top-barbershop/.env). В git не коммитить.
SITE_DOMAIN=new.top-barbershop.com
CMS_DOMAIN=cms.new.top-barbershop.com
SITE_ENV=staging            # staging = noindex везде; production — только после переключения DNS

POSTGRES_DB=topbs
POSTGRES_USER=topbs
POSTGRES_PASSWORD=

DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_WEB_TOKEN=          # статический токен роли web (только чтение публичных данных)

MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=

IMGPROXY_KEY=
IMGPROXY_SALT=

# Яндекс Карты: кабинет https://yandex.ru/maps-api/console/keys (JavaScript API + Геокодер)
YANDEX_MAPS_KEY=
# Yandex SmartCaptcha: консоль Yandex Cloud → SmartCaptcha
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
# Вход через соцсети: AUTH_PROVIDERS=yandex,vk — только когда заданы ключи ниже
AUTH_PROVIDERS=
# Яндекс ID: https://oauth.yandex.ru → Создать приложение (redirect: https://cms.<домен>/auth/login/yandex/callback)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# VK ID: https://id.vk.com/about/business → приложение (redirect: https://cms.<домен>/auth/login/vk/callback)
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
# Почта: Mail.ru для бизнеса (VK WorkSpace). Ящик noreply@top-barbershop.com + пароль для внешнего приложения
EMAIL_FROM=noreply@top-barbershop.com
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=noreply@top-barbershop.com
SMTP_PASSWORD=

# Эквайринг Точка Банк. JWT: интернет-банк → Сервисы → Интеграции и API → «Сгенерировать JWT-ключ»
# (разрешения: «Создание ссылки на оплату картой и через СБП» и «Создание и получение вебхуков»).
# JWT живёт ограниченный срок — следите за ротацией. customerCode/merchantId — запросить в чате Точки.
TOCHKA_JWT=
TOCHKA_CLIENT_ID=             # client_id из JWT-ключа
TOCHKA_CUSTOMER_CODE=         # уникальный код клиента
TOCHKA_MERCHANT_ID=           # необязательно: если пусто, берётся первая активная торговая точка
TOCHKA_ORDER_SECRET=          # секретный суффикс URL вебхука: /api/tochka/?key=...
TOCHKA_RECEIPT=1              # 0 — не передавать чек 54-ФЗ при создании платёжной ссылки
TOCHKA_TAX_SYSTEM=usn_income_outcome   # osn | usn_income | usn_income_outcome | esn | patent
# После настройки зарегистрировать вебхук (в интернет-банке этого раздела нет, только API):
#   cd web && TOCHKA_JWT=... TOCHKA_CLIENT_ID=... TOCHKA_CUSTOMER_CODE=... TOCHKA_ORDER_SECRET=... node scripts/tochka-setup.mjs

# Старый хостинг (только на время переноса данных)
OLD_FTP_HOST=92.53.96.50
OLD_FTP_USER=
OLD_FTP_PASS=
OLD_FTP_ROOT=/top-barbershop
