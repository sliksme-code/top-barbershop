{
	email admin@top-barbershop.com
	order replace after encode
}

# Админка Directus
{$CMS_DOMAIN} {
	encode zstd gzip
	reverse_proxy directus:8055
}

# Боевой домен: новый сайт (Astro + Postgres). Старый WordPress отключён.
(newsite) {
	encode zstd gzip
	import /etc/caddy/deploy/redirects.caddy
	handle_path /media/* {
		root * /srv/uploads
		# служебные файлы, случайно попавшие в uploads, не отдаём
		@priv path_regexp priv (\.php$|^/(iw-backup|wpallexport|wpallimport)/|mc4wp)
		handle @priv {
			respond 404
		}
		handle {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle_path /logos/* {
		root * /srv/logos
		file_server
	}
	handle_path /wp-content/uploads/* {
		root * /srv/uploads
		# служебные файлы, случайно попавшие в uploads, не отдаём
		@priv path_regexp priv (\.php$|^/(iw-backup|wpallexport|wpallimport)/|mc4wp)
		handle @priv {
			respond 404
		}
		handle {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle_path /img/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy imgproxy:8080
	}
	handle /_astro/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:4321
	}
	redir /index.php / 301
	@page1 path_regexp page1 ^(.*/)page/1/?$
	redir @page1 {re.page1.1} 301
	redir /feed /feed/ 301
	rewrite /feed/ /feed.xml
	redir /sitemap_index.xml /sitemap.xml 301
	redir /sitemap-index.xml /sitemap.xml 301
	redir /post-sitemap.xml /sitemap.xml 301
	redir /page-sitemap.xml /sitemap.xml 301
	redir /barbershop-sitemap.xml /sitemap.xml 301
	handle {
		reverse_proxy web:4321
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	handle_errors 502 503 504 {
		header Retry-After 120
		root * /etc/caddy/deploy
		rewrite * /maintenance.html
		file_server {
			status 503
		}
	}
}

{$PROD_DOMAIN} {
	import newsite
}

# Главное зеркало: https://top-barbershop.com — один 301 с любых http/www
http://{$PROD_DOMAIN}, http://www.{$PROD_DOMAIN} {
	redir https://{$PROD_DOMAIN}{uri} 301
}

# Тестовый домен — тот же сайт, но noindex (решает приложение по имени хоста)
{$SITE_DOMAIN} {
	import newsite
}

www.{$PROD_DOMAIN} {
	redir https://{$PROD_DOMAIN}{uri} 301
}
