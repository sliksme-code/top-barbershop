{
	email admin@top-barbershop.com
}

# Админка Directus — отдельный поддомен
{$CMS_DOMAIN} {
	encode zstd gzip
	reverse_proxy directus:8055
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# 301/410 со старых URL WordPress (генерируется скриптом migration/build_redirects.py)
	import /etc/caddy/deploy/redirects.caddy

	# Старые пути картинок и логотипов сохраняются 1:1
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /logos/* {
		root * /srv/media
		file_server
	}

	# Ресайз картинок
	handle_path /img/* {
		reverse_proxy imgproxy:8080
	}

	handle {
		reverse_proxy web:4321
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# www → без www
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} 301
}
