insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='modnye-muzhskie-strizhki-2026'), (select max(id)+1 from posts)), 'modnye-muzhskie-strizhki-2026', 'Модные мужские стрижки 2026: флоу, шторки и мягкие фейды', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>Главный тренд 2026 года — флоу: удлинённая стрижка без выбритых висков.</li><li>Вместо резких фейдов — плавные переходы и естественная текстура.</li><li>Остаются актуальными шторки с прямым пробором, баз-кат и короткий кроп.</li><li>Борода — полная, но ухоженная, с чёткими контурами.</li></ul></div>
<p>В 2010-е мужская мода на стрижки держалась на выбритых висках и чётких линиях. В 2026 году маятник качнулся в другую сторону: мужчины отращивают волосы, а стилисты советуют естественную форму и мягкие переходы. Вот что сейчас просят в барбершопах.</p>

<h2>Флоу</h2>
<p>Флоу (от английского flow — «поток») — удлинённая стрижка, при которой виски и бока не выбривают. Волосы зачёсывают назад или набок, а чёлку стригут слоями с филировкой концов, чтобы пряди лежали свободно. Men Today называет флоу главной стрижкой года, которая приходит на смену фейду.</p>
<p>У флоу есть несколько вариантов:</p>
<ul>
<li><b>Классический</b> — сдержанный зачёс назад с умеренной длиной на затылке, подходит для офиса.</li>
<li><b>Шторки</b> — прямой пробор и пряди, спадающие по бокам; популярен у молодых мужчин.</li>
<li><b>Хоккейный</b> — длиннее и объёмнее на затылке, ближе к маллету.</li>
<li><b>Гибридный</b> — самый строгий: виски и затылок аккуратно подстрижены.</li>
</ul>
<p><b>Как укладывать:</b> на влажные волосы нанести спрей с морской солью, высушить диффузором на слабом тепле или естественным путём, затем распределить немного матовой пасты лёгкой фиксации и уложить пальцами. Блестящие воски и гели флоу утяжеляют.</p>

<h2>Мягкие фейды и короткий кроп</h2>
<p>Фейды не исчезли совсем, но изменились. Стилисты, которых опросил Esquire UK, отмечают, что короткие стрижки с плотным верхом длиной 1–2 см остаются в моде, но переходы стали плавнее и незаметнее. Резкий контраст «под ноль сбоку — длинно сверху» выглядит уже как стрижка прошлого десятилетия.</p>

<h2>Баз-кат</h2>
<p>Самая короткая стрижка тоже в тренде: The Blueprint, проанализировав мужские показы, советует не ждать лета — баз-кат (buzz cut) актуален уже сейчас. Её выбирают те, кто не хочет тратить время на укладку.</p>

<h2>Длинные волосы и мужское каре</h2>
<p>На показах сезонов 2026 года много длинных волос и мужского каре. Такую длину нужно регулярно освежать: по совету стилистов, подравнивать концы раз в два-три месяца, когда волосы начинают касаться плеч и выворачиваться.</p>

<h2>Борода</h2>
<p>Полная борода от 3 см остаётся в моде, но в 2026 году она должна выглядеть как продуманная часть образа: ухоженная, с блеском и чёткими контурами. Отращивание занимает несколько месяцев, а форму нужно регулярно поддерживать у барбера.</p>

<h2>Как попросить барбера</h2>
<ol>
<li><b>Принесите фото</b> — лучше два-три, с разных ракурсов.</li>
<li><b>Говорите о длине, а не о названии:</b> «бока не выбривать», «оставить 10 см сверху», «переход плавный».</li>
<li><b>Расскажите, сколько времени готовы тратить на укладку.</b> Флоу требует пары минут по утрам, кроп — почти нисколько.</li>
<li><b>Отращивайте с барбером.</b> Переход с фейда на флоу займёт несколько месяцев: мастер поможет пройти «неудобную» длину.</li>
</ol>
<p>Найдите барбера в своём городе в <a href="/goroda/">каталоге барбершопов</a>. Больше идей — в рубрике <a href="/category/muzhskie-strizhki/">«Мужские стрижки»</a>.</p>
<h2>Источники</h2><ul class="sources"><li><a href="https://www.mentoday.ru/style/grooming/samaya-modnaya-mujskaya-strijka-2026-goda-chto-takoe-flou-i-kak-ego-nosit/" rel="nofollow noopener" target="_blank">Самая модная мужская стрижка 2026 года: что такое «флоу» — Men Today</a></li><li><a href="https://www.mentoday.ru/style/grooming/samye-modnye-mujskie-strijki-2026-goda-oni-tochno-budut-v-trende/" rel="nofollow noopener" target="_blank">Как выглядят самые модные мужские стрижки 2026 года — Men Today</a></li><li><a href="https://theblueprint.ru/beauty/hair/mens_hairstyles_2026" rel="nofollow noopener" target="_blank">На свою голову: мужские стрижки 2026 — The Blueprint</a></li><li><a href="https://theblueprint.ru/beauty/industry/beauty-trends-ss26" rel="nofollow noopener" target="_blank">Бьюти-тренды весна-лето 2026 — The Blueprint</a></li><li><a href="https://www.mentoday.ru/style/grooming/gid-po-usam-i-borodam-glavnye-trendy-v-rastitelnosti-na-mujskom-lice-sushchestvuyushchie-v-2026-godu/" rel="nofollow noopener" target="_blank">Гид по усам и бородам: тренды 2026 года — Men Today</a></li></ul>$c$, 'Мужчины отращивают волосы, резкие фейды уходят, а главной стрижкой года стал флоу. Разбираем тренды 2026 года, объясняем, как попросить барбера о нужной стрижке и чем её укладывать.', '/media/2026/08/modnye-muzhskie-strizhki-2026.jpg', 5064, 'Модные мужские стрижки 2026: флоу, шторки, баз-кат и фейды', 'Главные мужские стрижки 2026 года: флоу вместо фейда, шторки, баз-кат, кроп с мягким переходом и ухоженная борода. Как попросить барбера и как укладывать.', false, '2026-08-18 10:00:00+03', '2026-08-18 10:00:00+03'
on conflict (slug) do update set title=excluded.title, content=excluded.content, excerpt=excluded.excerpt, cover_image=excluded.cover_image, seo_title=excluded.seo_title, seo_description=excluded.seo_description, status='published', published_at=excluded.published_at, updated_at=excluded.updated_at;
insert into post_categories (post_id, category_id) select p.id, c.id from posts p, categories c where p.slug='modnye-muzhskie-strizhki-2026' and c.slug='muzhskie-strizhki' and not exists (select 1 from post_categories x where x.post_id=p.id and x.category_id=c.id);
insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='skolko-stoit-muzhskaya-strizhka-2026'), (select max(id)+1 from posts)), 'skolko-stoit-muzhskaya-strizhka-2026', 'Сколько стоит мужская стрижка в 2026 году', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>По Росстату, модельная стрижка в мужском зале в июле 2026 года стоила в среднем 764 ₽ — на 16,3% больше, чем годом ранее, при инфляции 5,6% за 2025 год.</li><li>Средний чек в сетевых барбершопах в начале 2026 года — около 1 970 ₽, в Петербурге — 2 100–2 260 ₽.</li><li>Базовый мужской набор (стрижка, борода, маникюр, педикюр) в миллионниках обходится в среднем в 6 989 ₽.</li><li>За три года число барбершопов в миллионниках выросло на 43% — до 4 916.</li></ul></div>
<p>Стрижка — одна из услуг, по которым инфляция видна лучше всего: мужчины стригутся регулярно и хорошо помнят прошлую цену. Посмотрим, что говорят разные источники.</p>

<h2>Средняя цена по Росстату</h2>
<p>Росстат еженедельно отслеживает цену модельной стрижки в мужском зале. По данным сервиса 1000bankov, который публикует этот ряд, 13 июля 2026 года она стоила в среднем 764 ₽ — на 16,3% больше, чем годом ранее. Инфляция за 2025 год составила 5,6%, то есть стрижка дорожает втрое быстрее цен в целом. В январе 2023 года та же услуга стоила около 522 ₽: за три с половиной года рост — примерно 46%.</p>
<p>Важно: в выборку Росстата попадают все парикмахерские, включая эконом-формат. Стрижка в барбершопе обычно стоит заметно дороже.</p>

<h2>Средний чек в барбершопах</h2>
<table>
<thead><tr><th>Источник</th><th>Период</th><th>Средний чек</th></tr></thead>
<tbody>
<tr><td>Т-Банк, крупные сети барбершопов</td><td>I квартал 2026</td><td>1 972 ₽ (+14%)</td></tr>
<tr><td>«Эвотор», барбершопы Петербурга</td><td>I квартал 2026</td><td>2 256 ₽ (+16%)</td></tr>
<tr><td>YCLIENTS, барберы Петербурга</td><td>Март 2026</td><td>2 096 ₽ (+16%)</td></tr>
</tbody>
</table>
<p>Средний чек включает не только стрижку, но и бороду, бритьё и косметику. По оценке сооснователя BarbarossA, базовые услуги в Москве и других крупных городах начинаются от 2 500 ₽, а средний чек в Москве и Петербурге на 30–50% выше, чем в регионах.</p>

<h2>Во что обходится мужской уход</h2>
<p>2ГИС в сентябре 2026 года подсчитал стоимость базового набора процедур в городах-миллионниках. Мужской набор — стрижка, оформление бороды, маникюр и педикюр — обходится в среднем в 6 989 ₽. Для сравнения, женский набор стоит 11 232 ₽.</p>
<p>Если сопоставить цены со средними зарплатами, мужчина в миллионнике может позволить себе в среднем 14 таких наборов в месяц. Больше всего — в Москве (20), Перми и Красноярске (по 16): высокие цены там компенсируются высокими зарплатами.</p>

<h2>Где барбершопов становится больше</h2>
<p>По данным 2ГИС, с сентября 2023 по сентябрь 2026 года число барбершопов в миллионниках выросло с 3 430 до 4 916 — на 43,3%. За последний год рост составил 7,9%. Быстрее всего за три года росли Воронеж (+76,3%), Пермь (+71,4%) и Волгоград (+70,2%), а за последний год — Красноярск (+32%).</p>
<p>Обычные парикмахерские при этом сокращаются: за год их стало на 1,7% меньше, в Москве — на 4,4%, в Казани — на 3,5%. Мужчины уходят из универсальных салонов в специализированные барбершопы.</p>

<h2>Почему стрижка дорожает</h2>
<ul>
<li><b>Зарплаты мастеров</b> растут быстрее рынка — барберов не хватает.</li>
<li><b>Аренда и расходы</b> растут вместе с инфляцией.</li>
<li><b>Налоговая реформа:</b> часть барбершопов с 2026 года платит НДС.</li>
</ul>

<h2>Как не переплачивать</h2>
<ul>
<li>Сравните цены нескольких барбершопов рядом с домом или работой — в каталоге они собраны по городам и станциям метро, например <a href="/location/russia/msk/">в Москве</a> или <a href="/location/russia/spb/">Петербурге</a>.</li>
<li>Спросите про скидки на комплекс «стрижка + борода» и семейные визиты «отец + сын».</li>
<li>Выбирайте стрижку, которой не нужна коррекция каждые три недели.</li>
</ul>
<h2>Источники</h2><ul class="sources"><li><a href="https://1000bankov.ru/inflation/products/strizhka-modelnaya-v-muzhskom-zale/" rel="nofollow noopener" target="_blank">Стрижка модельная в мужском зале — цена (данные Росстата) — 1000bankov</a></li><li><a href="https://www.retail.ru/news/2gis-skolko-stoyat-byuti-protsedury-v-millionnikakh-i-kak-razvivaetsya-industriya-9-sentyabrya-2026-281899/" rel="nofollow noopener" target="_blank">2ГИС: сколько стоят бьюти-процедуры в миллионниках — Retail.ru</a></li><li><a href="https://www.fontanka.ru/2026/04/26/76388052/" rel="nofollow noopener" target="_blank">Расти, борода. Почему барбершопы теряют клиентов — Фонтанка</a></li><li><a href="https://www.dp.ru/a/2026/04/26/v-peterburge-do-konca-2026" rel="nofollow noopener" target="_blank">Барбершопы Петербурга недосчитались клиентов — Деловой Петербург</a></li><li><a href="https://incrussia.ru/share/rynok-barbershopov/" rel="nofollow noopener" target="_blank">Как устроена индустрия барбершопов в России — Inc. Russia</a></li></ul>$c$, 'Мужская стрижка за год подорожала на 16% — втрое быстрее инфляции. Сравниваем данные Росстата, касс и 2ГИС: сколько стоит стрижка в парикмахерской и барбершопе, во что обходится базовый мужской уход и где барбершопов становится больше всего.', '/media/2026/09/skolko-stoit-muzhskaya-strizhka-2026.jpg', 5064, 'Сколько стоит мужская стрижка в 2026 году: цены и рост', 'Мужская стрижка за год подорожала на 16% — втрое быстрее инфляции. Цены Росстата, средний чек барбершопов, стоимость мужского ухода в миллионниках по данным 2ГИС.', false, '2026-09-22 10:00:00+03', '2026-09-22 10:00:00+03'
