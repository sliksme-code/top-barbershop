insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='skolko-stoit-otkryt-barbershop-2026'), (select max(id)+1 from posts)), 'skolko-stoit-otkryt-barbershop-2026', 'Сколько стоит открыть барбершоп в 2026 году', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>Интерьер барбершопа обходится от 500 тыс. до 2 млн ₽ и выше; полные вложения во франшизу крупной сети — от 5,5 млн ₽.</li><li>Аренда съедает 15–25% бюджета, оплата мастеров — 35–45% выручки.</li><li>Окупаемость — 12–18 месяцев в Москве и миллионниках и до 24 месяцев в регионах.</li><li>Хорошей маржой в 2026 году считаются 10–12% против 20% годом-двумя ранее.</li></ul></div>
<p>Барбершоп остаётся одним из самых понятных форматов малого бизнеса: небольшое помещение, несколько кресел, предсказуемый спрос. Но цифры 2026 года заставляют считать внимательнее: маржа сократилась, а налоговая реформа добавила расходов.</p>

<h2>Стартовые вложения</h2>
<ul>
<li><b>Ремонт и интерьер:</b> по опыту сети BarbarossA, которым сооснователь поделился с Inc. Russia, — от 500 тыс. до 2 млн ₽ и выше. Экономить на креслах опасно: в одном из проектов сети неудобные кресла стоили почти 40% клиентов.</li>
<li><b>Франшиза крупной сети:</b> по открытым данным, которые приводило BFM, франшиза TOPGUN стоит 2–2,5 млн ₽, паушальный взнос — 0,5–1 млн ₽, роялти — 5%. В каталоге Topfranchise общие вложения в TOPGUN указаны от 5,5 млн ₽.</li>
<li><b>Оборудование, косметика, первый запас расходников</b> и деньги на запуск рекламы.</li>
<li><b>Резерв на первые месяцы:</b> пока запись не заполнена, аренду и гарантированный минимум мастерам придётся платить из своих.</li>
</ul>

<h2>Ежемесячные расходы</h2>
<table>
<thead><tr><th>Статья</th><th>Ориентир</th></tr></thead>
<tbody>
<tr><td>Оплата мастеров</td><td>35–45% выручки</td></tr>
<tr><td>Аренда</td><td>15–25% бюджета</td></tr>
<tr><td>Привлечение клиента</td><td>1 500–2 000 ₽ — примерно стоимость одной стрижки</td></tr>
<tr><td>Роялти по франшизе</td><td>около 5% выручки</td></tr>
</tbody>
</table>
<p>Ориентиры — из колонки сооснователя BarbarossA в Inc. Russia и открытых условий франшиз. В среднем, по его опыту, в барбершопе работают 6–8 мастеров, а стрижки дают около 70% выручки.</p>

<h2>Окупаемость и маржа</h2>
<p>По тем же данным, барбершоп окупается за 12–18 месяцев в Москве и миллионниках и до 24 месяцев в регионах. В городах с населением меньше 200 тыс. спрос ограничен, и экспериментировать с форматом там рискованнее.</p>
<p>Весной 2026 года основатель салона Skalptura Даниил Марков рассказал «Фонтанке», что хорошей маржой сейчас считаются 10–12%, тогда как в 2024 — начале 2025 года ориентиром были 20%. Владелец небольшого барбершопа, по его словам, может зарабатывать около 150 тыс. ₽ в месяц при большой нагрузке и ответственности.</p>

<h2>Франшиза или свой бренд</h2>
<table>
<thead><tr><th></th><th>Франшиза</th><th>Свой барбершоп</th></tr></thead>
<tbody>
<tr><td>Вложения</td><td>Выше: взнос, стандарты интерьера</td><td>Ниже, гибкий бюджет</td></tr>
<tr><td>Узнаваемость</td><td>С первого дня</td><td>Строится годами</td></tr>
<tr><td>Мастера</td><td>Помогает школа сети</td><td>Нужно искать и учить самому</td></tr>
<tr><td>Ежемесячные платежи</td><td>Роялти и маркетинговый сбор</td><td>Нет</td></tr>
<tr><td>Свобода</td><td>Ограничена стандартами</td><td>Полная</td></tr>
</tbody>
</table>

<h2>Чек-лист перед открытием</h2>
<ol>
<li><b>Посчитайте налоги.</b> С 2026 года порог НДС для «упрощёнки» — 20 млн ₽ в год. Подробности — в нашем материале <a href="/nalogovaya-reforma-2026-barbershopy/">о налоговой реформе</a>.</li>
<li><b>Проверьте конкуренцию.</b> По данным 2ГИС, на апрель 2026 года барбершопов в миллионниках стало на 11% больше, чем годом ранее. Посмотрите, сколько барбершопов уже работает у вашей станции метро — например, в <a href="/location/russia/msk/">каталоге Москвы</a>.</li>
<li><b>Определите сегмент.</b> Клиенты смещаются из премиума в средний сегмент и эконом — формат и цены нужно выбирать под свою улицу.</li>
<li><b>Найдите мастеров до открытия.</b> Барберов не хватает, и сильные мастера часто приходят со своими клиентами.</li>
<li><b>Подключите онлайн-запись и каталоги заранее.</b> Первые клиенты приходят из поиска и карт.</li>
</ol>
<p>Уже открылись? <a href="/add/">Добавьте барбершоп в каталог TOP BARBERSHOP</a> — это бесплатно.</p>
<h2>Источники</h2><ul class="sources"><li><a href="https://incrussia.ru/share/rynok-barbershopov/" rel="nofollow noopener" target="_blank">Как устроена индустрия барбершопов в России — Inc. Russia</a></li><li><a href="https://www.bfm.ru/news/584488" rel="nofollow noopener" target="_blank">В России вырос спрос на франшизы в сфере бьюти-услуг — BFM</a></li><li><a href="https://topfranchise.ru/products/franshiza-muzhskoy-parikmakherskoy-topgun-barbershop/" rel="nofollow noopener" target="_blank">Франшиза ТОПГАН — Topfranchise</a></li><li><a href="https://www.fontanka.ru/2026/04/26/76388052/" rel="nofollow noopener" target="_blank">Расти, борода. Почему барбершопы теряют клиентов — Фонтанка</a></li><li><a href="https://www.dp.ru/a/2026/04/26/v-peterburge-do-konca-2026" rel="nofollow noopener" target="_blank">Барбершопы Петербурга недосчитались клиентов — Деловой Петербург</a></li></ul>$c$, 'Открыть барбершоп по-прежнему проще, чем салон красоты, но экономика в 2026 году стала жёстче: маржа сократилась, а налоги выросли. Считаем вложения, расходы и сроки окупаемости, сравниваем франшизу и собственный бренд.', '/media/2026/07/skolko-stoit-otkryt-barbershop-2026.jpg', 5064, 'Сколько стоит открыть барбершоп в 2026: вложения и окупаемость', 'Вложения от 0,5 до 5,5 млн ₽, окупаемость 12–24 месяца, маржа 10–12%. Разбираем экономику барбершопа в 2026 году: аренда, мастера, франшиза или свой бренд.', false, '2026-07-14 10:00:00+03', '2026-07-14 10:00:00+03'
on conflict (slug) do update set title=excluded.title, content=excluded.content, excerpt=excluded.excerpt, cover_image=excluded.cover_image, seo_title=excluded.seo_title, seo_description=excluded.seo_description, status='published', published_at=excluded.published_at, updated_at=excluded.updated_at;
