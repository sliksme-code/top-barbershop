insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='nalogovaya-reforma-2026-barbershopy'), (select max(id)+1 from posts)), 'nalogovaya-reforma-2026-barbershopy', 'Налоговая реформа 2026: что меняется для барбершопов', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>Базовая ставка НДС с 1 января 2026 года — 22% вместо 20%.</li><li>Порог освобождения от НДС на УСН снижен с 60 до 20 млн ₽ дохода за год; до 20 млн ₽ снижен и лимит патента.</li><li>20 млн ₽ в год — это около 1,67 млн ₽ выручки в месяц: на такую выручку может выйти барбершоп на 6–8 мастеров с плотной записью.</li><li>Для тех, кто перешагнул порог, есть пониженные ставки 5% и 7% без права на вычеты.</li></ul></div>
<p>Для малого бизнеса в сфере красоты 2026 год начался с самых заметных налоговых изменений за последние годы. Барбершопы — типичный пример бизнеса, которого они касаются напрямую: большинство работает на упрощённой системе или патенте, а выручка средней точки с несколькими креслами как раз находится около новых порогов.</p>

<h2>Что изменилось с 1 января 2026 года</h2>
<ul>
<li><b>Ставка НДС.</b> Основная ставка выросла с 20 до 22%, расчётная — с 20/120 до 22/122.</li>
<li><b>НДС на «упрощёнке».</b> Раньше ИП и компании на УСН не платили НДС, пока доход не превышал 60 млн ₽ в год. Теперь порог — 20 млн ₽. Если доход за 2025 год был не выше 20 млн ₽, в 2026-м НДС платить не нужно, и уведомлять налоговую об освобождении не требуется. Если порог превышен в течение 2026 года, НДС начисляется с 1-го числа следующего месяца.</li>
<li><b>Дальнейшее снижение.</b> По принятому графику порог должен опуститься до 15 млн ₽ в 2027 году и до 10 млн ₽ с 2028-го.</li>
<li><b>Пониженные ставки.</b> Тот, кто перешагнул порог, может платить НДС по ставке 5% (если доход в 2026 году не превысит 272,5 млн ₽) или 7% — но без вычетов входящего НДС. Альтернатива — общая ставка 22% с вычетами.</li>
<li><b>Патент.</b> Лимит доходов для патентной системы тоже снижен до 20 млн ₽. Предприниматели, которые раньше спокойно укладывались в патент, при превышении переходят на УСН — а вместе с ней в зону НДС.</li>
</ul>

<h2>Много ли это для барбершопа</h2>
<p>20 млн ₽ в год — около 1,67 млн ₽ выручки в месяц. Посчитаем на примере: по данным «Платформы ОФД», в первом квартале 2025 года средний чек в салонах красоты составлял около 2,1 тыс. ₽. При таком чеке 20 млн ₽ — это примерно 9,5 тыс. визитов в год, или около 26 клиентов в день без выходных. Барбершоп на 6–8 мастеров с плотной записью вполне может выйти на такую выручку, а точка на 2–3 кресла, скорее всего, останется ниже порога.</p>
<p>Поэтому под НДС в первую очередь попадают успешные отдельные барбершопы и точки сетей, которые работают через одно юрлицо или ИП.</p>

<h2>Чем это грозит рынку</h2>
<p>В журнале «Контура» основатель сети клиник Константин Гонке ещё в декабре оценил, что салонам, ставшим плательщиками НДС, для сохранения доходности придётся поднять цены минимум на 15–25%, а маржинальность может упасть примерно с 20% до 7–8%. По его оценке, частные мастера и самозанятые, которые не платят НДС, окажутся на 20–30% дешевле салонов и заберут часть клиентов.</p>
<p>Отрасль входит в реформу не в лучшей форме: по тем же данным, за три года количество организаций салонного бизнеса сократилось на 9,6% — со 123,1 до 111,2 тыс., при этом закрылось больше точек (77,1 тыс.), чем открылось (65,2 тыс.).</p>

<h2>Что сделать владельцу барбершопа</h2>
<ol>
<li><b>Посчитать доход за 2025 год</b> по каждому ИП и юрлицу. От этой цифры зависит, платите ли вы НДС с января.</li>
<li><b>Сравнить варианты:</b> ставка 5–7% без вычетов или 22% с вычетами. Для барбершопа, где основная часть расходов — зарплата мастеров и аренда без НДС, пониженная ставка обычно выгоднее, но расчёт нужно делать на своих цифрах.</li>
<li><b>Пересмотреть прайс.</b> Резкое повышение цен в январе рискованно: часть клиентов уйдёт к частным мастерам. Многие владельцы выбирают поэтапное повышение и дополнительные услуги вместо подорожания базовой стрижки.</li>
<li><b>Не дробить бизнес искусственно.</b> Разделение одной точки на несколько ИП ради лимита налоговая расценивает как схему — с доначислениями и штрафами.</li>
<li><b>Поднять загрузку.</b> Пустое кресло теперь обходится дороже. Онлайн-запись, напоминания клиентам и присутствие в каталогах помогают заполнять окна без скидок.</li>
</ol>
<p>Материал носит информационный характер и не заменяет консультацию бухгалтера: условия зависят от вашей системы налогообложения и структуры бизнеса.</p>
<h2>Источники</h2><ul class="sources"><li><a href="https://pay.yandex.ru/blog/articles/nalogovye-izmeneniya-2026" rel="nofollow noopener" target="_blank">Налоговые изменения 2026 — блог Яндекс Пэй</a></li><li><a href="https://www.regberry.ru/nalogooblozhenie/izmeneniya-po-nds-na-usn-2026" rel="nofollow noopener" target="_blank">Изменения по НДС для УСН в 2026 — Regberry</a></li><li><a href="https://kontur.ru/articles/347" rel="nofollow noopener" target="_blank">Повышение НДС в 2026 году: как налоговая реформа изменит бьюти-рынок — Контур</a></li><li><a href="https://www.kommersant.ru/doc/7711286" rel="nofollow noopener" target="_blank">Средний чек в салонах красоты в I квартале 2025 года — Коммерсантъ</a></li></ul>$c$, 'С 1 января 2026 года ставка НДС выросла до 22%, а порог освобождения от НДС на «упрощёнке» снизился втрое — до 20 млн ₽. Считаем, как это ударит по барбершопам и что владельцу стоит сделать уже сейчас.', '/media/2026/01/nalogovaya-reforma-2026-barbershopy.jpg', 5064, 'Налоговая реформа 2026 для барбершопов: НДС на УСН и лимит патента', 'С 2026 года порог НДС для УСН снижен до 20 млн ₽, ставка выросла до 22%, лимит патента — 20 млн ₽. Разбираем, что это значит для барбершопа и что сделать.', false, '2026-01-20 10:00:00+03', '2026-01-20 10:00:00+03'
on conflict (slug) do update set title=excluded.title, content=excluded.content, excerpt=excluded.excerpt, cover_image=excluded.cover_image, seo_title=excluded.seo_title, seo_description=excluded.seo_description, status='published', published_at=excluded.published_at, updated_at=excluded.updated_at;
insert into post_categories (post_id, category_id) select p.id, c.id from posts p, categories c where p.slug='nalogovaya-reforma-2026-barbershopy' and c.slug='novosti' and not exists (select 1 from post_categories x where x.post_id=p.id and x.category_id=c.id);
insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='rynok-barbershopov-rossii-itogi-2025'), (select max(id)+1 from posts)), 'rynok-barbershopov-rossii-itogi-2025', 'Рынок барбершопов России: итоги 2025 года в цифрах', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>Интерес россиян к услугам барберов в 2025 году вырос на 34% — быстрее, чем к любым другим парикмахерским услугам.</li><li>В 2025 году зарегистрировано 30 239 компаний и ИП в бьюти-сфере — на 14% больше, чем годом ранее.</li><li>Средняя зарплата барбера, по данным YCLIENTS, выросла за год на 17,4% — до 85,5 тыс. ₽ в месяц.</li><li>Почти половина барбершопов каталога TOP BARBERSHOP — в Москве и Петербурге.</li></ul></div>
<p>Барбершопы в России давно перестали быть модной новинкой и превратились в отдельный сегмент индустрии красоты. 2025 год показал, что спрос на мужские стрижки продолжает расти, хотя рост всё больше держится на ценах, а не на количестве клиентов. Разберём главные цифры.</p>

<h2>Спрос: барберов ищут чаще всех</h2>
<p>По совместному исследованию «Авито Услуг» и «Авито Подработки», которое приводит ТАСС, в 2025 году спрос на услуги парикмахеров вырос на 11%. Быстрее всего рос интерес именно к барберам — на 34%. Для сравнения: спрос на стрижку, окрашивание и укладку в целом прибавил около 9,7%.</p>
<p>Аудитория при этом молодеет. Сооснователь сети BarbarossA Евгений Туаев в колонке для Inc. Russia отмечал, что основной возраст клиентов барбершопов за десять лет сместился с 30–45 до 25–45 лет.</p>

<h2>Предложение: бизнесов становится больше</h2>
<ul>
<li>В 2025 году в России зарегистрировали <b>30 239</b> компаний и ИП в бьюти-сфере (парикмахерские, барбершопы, маникюрные кабинеты, салоны) — на 14% больше, чем в 2024-м (26 536).</li>
<li>По данным ассоциации «Красивый бизнес», к январю 2025 года в стране работало <b>76,1 тыс.</b> салонов красоты — на 15,7% больше, чем годом ранее.</li>
<li>Число барбершопов в городах-миллионниках в 2024 году выросло на <b>18,6%</b> — этот темп упоминается в той же статье Inc. Russia.</li>
</ul>

<h2>Деньги: чек и зарплаты растут</h2>
<p>По данным «Платформы ОФД», в первом квартале 2025 года средний чек в салонах красоты вырос на 14% и достиг 2,1 тыс. ₽. Сервис YCLIENTS подсчитал, что средняя зарплата барбера в марте 2025 года составила 85,5 тыс. ₽ в месяц — на 17,4% больше, чем годом ранее. Это самый быстрый рост среди специалистов индустрии красоты.</p>
<p>Работодатели, которым не хватает мастеров, стали охотнее брать новичков: по данным hh.ru, в январе–апреле 2025 года на вакансии без опыта пришлось 17% предложений.</p>

<h2>География: где больше всего барбершопов</h2>
<p>Мы посмотрели на распределение 1 436 опубликованных карточек в каталоге TOP BARBERSHOP. Это не полная перепись рынка, но хорошо показывает, где сосредоточена мужская индустрия.</p>
<table>
<thead><tr><th>Город</th><th>Барбершопов в каталоге</th></tr></thead>
<tbody>
<tr><td><a href="/location/russia/msk/">Москва</a></td><td>516</td></tr>
<tr><td><a href="/location/russia/spb/">Санкт-Петербург</a></td><td>188</td></tr>
<tr><td><a href="/location/russia/krasnodar/">Краснодар</a></td><td>43</td></tr>
<tr><td><a href="/location/russia/kzn/">Казань</a></td><td>38</td></tr>
<tr><td><a href="/location/russia/ekb/">Екатеринбург</a></td><td>25</td></tr>
<tr><td><a href="/location/russia/nnov/">Нижний Новгород</a></td><td>24</td></tr>
<tr><td><a href="/location/russia/samara/">Самара</a></td><td>22</td></tr>
<tr><td><a href="/location/russia/nsk/">Новосибирск</a></td><td>21</td></tr>
</tbody>
</table>
<p>На Москву и Петербург приходится почти половина карточек (704 из 1 436). Около половины барбершопов каталога — филиалы сетей, остальные — независимые точки. О крупнейших сетях мы расскажем отдельно.</p>

<h2>Что ждать в 2026 году</h2>
<p>Рост 2025 года во многом обеспечен подорожанием услуг. С января 2026-го на рынок давит налоговая реформа: порог НДС для «упрощёнки» снижен до 20 млн ₽. Мы подробно разобрали её в материале <a href="/nalogovaya-reforma-2026-barbershopy/">«Налоговая реформа 2026: что меняется для барбершопов»</a>. Конкуренция за клиента будет расти, и выиграют те, кто удерживает постоянных гостей и легко находится в поиске.</p>
<h2>Источники</h2><ul class="sources"><li><a href="https://finance.mail.ru/article/issledovanie-pokazalo-chto-interes-rossiyan-k-uslugam-barberov-vyiros-na-tret-69194081/" rel="nofollow noopener" target="_blank">Интерес россиян к услугам барберов вырос на треть — ТАСС / Mail Финансы</a></li><li><a href="https://finance.mail.ru/article/v-rossii-vyroslo-chislo-registracij-salonov-krasoty-69197920/" rel="nofollow noopener" target="_blank">В России выросло число регистраций салонов красоты — Mail Финансы</a></li><li><a href="https://profile.ru/society/ot-manikjura-do-magii-uspeha-v-rossii-nabirajut-populyarnost-uslugi-po-uhodu-za-vneshnostju-1711989/amp/" rel="nofollow noopener" target="_blank">Число салонов красоты в России — Профиль</a></li><li><a href="https://incrussia.ru/share/rynok-barbershopov/" rel="nofollow noopener" target="_blank">Как устроена индустрия барбершопов в России — Inc. Russia</a></li><li><a href="https://www.kommersant.ru/doc/7711286" rel="nofollow noopener" target="_blank">Зарплаты барберов и средний чек салонов — Коммерсантъ</a></li></ul>$c$, 'Спрос на барберов вырос на треть, бьюти-бизнесов стало заметно больше, а зарплаты мастеров растут быстрее всего в индустрии красоты. Собрали главные цифры 2025 года и посмотрели, где сосредоточены барбершопы.', '/media/2026/02/rynok-barbershopov-rossii-itogi-2025.jpg', 5064, 'Рынок барбершопов России 2025: итоги года в цифрах', 'Спрос на барберов вырос на 34%, бьюти-бизнесов зарегистрировали на 14% больше, зарплаты мастеров растут быстрее рынка. Главные цифры рынка барбершопов за 2025 год.', false, '2026-02-18 10:00:00+03', '2026-02-18 10:00:00+03'
on conflict (slug) do update set title=excluded.title, content=excluded.content, excerpt=excluded.excerpt, cover_image=excluded.cover_image, seo_title=excluded.seo_title, seo_description=excluded.seo_description, status='published', published_at=excluded.published_at, updated_at=excluded.updated_at;
insert into post_categories (post_id, category_id) select p.id, c.id from posts p, categories c where p.slug='rynok-barbershopov-rossii-itogi-2025' and c.slug='stati' and not exists (select 1 from post_categories x where x.post_id=p.id and x.category_id=c.id);
insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='rynok-muzhskoj-kosmetiki-rossii-2025'), (select max(id)+1 from posts)), 'rynok-muzhskoj-kosmetiki-rossii-2025', 'Мужская косметика в России: рынок растёт вдвое быстрее женского', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>Весь российский рынок косметики и парфюмерии в 2025 году достиг 1,2–1,3 трлн ₽.</li><li>Мужской сегмент оценивается в 300–325 млрд ₽ и вырос примерно на 20% — почти вдвое быстрее женского.</li><li>Главные драйверы — маркетплейсы, рост числа барбершопов и привычка мужчин к регулярному уходу.</li><li>В «Золотом Яблоке» спрос на мужские помады для укладки в начале 2025 года вырос в семь раз.</li></ul></div>
<p>Ещё десять лет назад мужской уход в России сводился к пене для бритья и гелю для душа. Теперь мужчины покупают глину для укладки, масло для бороды, сыворотки и солнцезащитные средства — и делают это всё чаще. 2025 год подтвердил: мужская косметика — один из самых быстрорастущих сегментов рынка.</p>

<h2>Размер рынка</h2>
<p>По данным «Альфа-Банка» и «INFOLine-аналитики», которые приводили «Ведомости», общий оборот рынка косметики и парфюмерии в России по итогам 2025 года достиг 1,2–1,3 трлн ₽, а в денежном выражении рынок вырос примерно на 7–15%.</p>
<p>Мужской сегмент, по оценке, приведённой в пресс-релизе ICE Professional, составил 300–325 млрд ₽ и вырос на 20%. В марте 2026 года аналитики, обобщая итоги года, отмечали, что мужская косметика растёт вдвое быстрее женской — примерно 20% против 13%. Среди причин называют маркетплейсы, рост числа барбершопов и меняющиеся привычки покупателей.</p>

<h2>Что и где покупают мужчины</h2>
<ul>
<li><b>Средства для укладки.</b> Сеть «Золотое Яблоко» сообщала, что в первом квартале 2025 года совокупная выручка по мужским товарам выросла на 43%, а спрос на мужские помады для укладки — в семь раз.</li>
<li><b>Уход стал привычкой.</b> По данным сети «О’КЕЙ», мужчины в 2025 году покупали косметику на 18% чаще, чем годом ранее.</li>
<li><b>Маркетплейсы.</b> Бьюти-категория Ozon в первом полугодии 2025 года росла на 42% год к году. Пять из десяти самых продаваемых бьюти-брендов площадки — российские, и на них пришлось 40% продаж.</li>
</ul>

<h2>Барбершоп как витрина</h2>
<p>Барбершопы стали для многих мужчин первым местом, где им объяснили, чем паста отличается от глины. Почти все заведения в каталоге TOP BARBERSHOP — 1 363 из 1 436 карточек — отмечают, что продают косметику.</p>
<p>Для бизнеса это заметная статья дохода. Сооснователь сети BarbarossA рассказывал Inc. Russia, что собственная линейка из 40 средств увеличила LTV клиента на 25%, а косметику в их салонах покупают 45–50% гостей. Это опыт одной сети, но он показывает потенциал: клиент доверяет совету барбера больше, чем рекламе.</p>

<h2>Что входит в базовый набор</h2>
<ul>
<li><b>Средство для укладки</b> под тип стрижки: матовая паста или глина для текстуры, помада — для гладких зачёсов.</li>
<li><b>Шампунь для частого мытья:</b> мужчины с короткой стрижкой моют голову почти каждый день.</li>
<li><b>Масло или бальзам для бороды:</b> смягчает волосы и убирает зуд, особенно в первые недели отращивания.</li>
<li><b>Средство после бритья:</b> бальзам без спирта меньше раздражает кожу.</li>
</ul>
<p>О том, как выбрать и использовать средства, читайте в рубрике <a href="/category/muzhskaya-kosmetika/">«Мужская косметика»</a>.</p>
<h2>Источники</h2><ul class="sources"><li><a href="https://new-retail.ru/novosti/retail/prodazhi_muzhskoy_kosmetiki_v_rossii_rastut_bystree_zhenskoy/" rel="nofollow noopener" target="_blank">Продажи мужской косметики в России растут быстрее женской — New Retail</a></li><li><a href="https://www.retail.ru/rbc/pressreleases/kholodnyy-raschet-i-novyy-segment-rynka-ice-professional-by-natura-siberica-zapuskaet-muzhskuyu-koll/" rel="nofollow noopener" target="_blank">Рынок мужской косметики и парфюмерии в 2025 году — Retail.ru</a></li><li><a href="https://runews24.ru/business/16/03/2026/prodazhi-muzhskoj-kosmetiki-v-rf-rastut-vdvoe-byistree-zhenskoj" rel="nofollow noopener" target="_blank">Продажи мужской косметики растут вдвое быстрее женской — RuNews24</a></li><li><a href="https://www.retail.ru/news/yumoney-muzhchiny-stali-chashche-pokupat-ukhodovuyu-kosmetiku-23-maya-2025-264955/" rel="nofollow noopener" target="_blank">ЮMoney: мужчины стали чаще покупать уходовую косметику — Retail.ru</a></li><li><a href="https://secrets.tbank.ru/novosti/populyarnost-muzhskoy-kosmetiki/" rel="nofollow noopener" target="_blank">Популярность мужской косметики — Т-Бизнес секреты</a></li><li><a href="https://new-retail.ru/business/e_commerce/ozon_analitika_i_trendy_beauty_rynka/" rel="nofollow noopener" target="_blank">Ozon: аналитика и тренды beauty-рынка — New Retail</a></li><li><a href="https://incrussia.ru/share/rynok-barbershopov/" rel="nofollow noopener" target="_blank">Как устроена индустрия барбершопов в России — Inc. Russia</a></li></ul>$c$, 'Пока весь рынок косметики прибавил 7–15%, мужской сегмент вырос примерно на 20%. Разбираемся, что покупают мужчины, почему растут продажи средств для укладки и как на этом зарабатывают барбершопы.', '/media/2026/03/rynok-muzhskoj-kosmetiki-rossii-2025.jpg', 5064, 'Рынок мужской косметики в России 2025: цифры и тренды', 'Мужская косметика и парфюмерия в 2025 году выросли примерно на 20% — до 300–325 млрд ₽. Что покупают мужчины, при чём здесь маркетплейсы и барбершопы.', false, '2026-03-19 10:00:00+03', '2026-03-19 10:00:00+03'
on conflict (slug) do update set title=excluded.title, content=excluded.content, excerpt=excluded.excerpt, cover_image=excluded.cover_image, seo_title=excluded.seo_title, seo_description=excluded.seo_description, status='published', published_at=excluded.published_at, updated_at=excluded.updated_at;
insert into post_categories (post_id, category_id) select p.id, c.id from posts p, categories c where p.slug='rynok-muzhskoj-kosmetiki-rossii-2025' and c.slug='muzhskaya-kosmetika' and not exists (select 1 from post_categories x where x.post_id=p.id and x.category_id=c.id);
insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='krupnejshie-seti-barbershopov-rossii-2026'), (select max(id)+1 from posts)), 'krupnejshie-seti-barbershopov-rossii-2026', 'Крупнейшие сети барбершопов России: кто они и как растут', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>Почти все крупные сети барбершопов растут за счёт франшизы, а не собственных точек.</li><li>TOPGUN — более 200 филиалов, OldBoy — более 100, у Borodach — свыше 140 локаций.</li><li>Вход в франшизу крупной сети обычно стоит 2–2,5 млн ₽, общие вложения — от 5,5 млн ₽.</li><li>Сети чистят портфель: TOPGUN за год закрыл 22 точки, которые не тянули стандарт.</li></ul></div>
<p>Российский рынок барбершопов во многом создали несколько сетей, которые в середине 2010-х превратили мужскую стрижку в отдельный формат. Сегодня большинство из них развивается по франшизе, а рядом с ними работают тысячи независимых барбершопов. Собрали короткие профили крупнейших игроков.</p>

<h2>TOPGUN</h2>
<p>Первый барбершоп TOPGUN открылся в 2014 году в Туле. Гендиректор сети Любовь Белинская рассказывала Sostav, что тогда в Москве была лишь небольшая сеть примерно из шести барбершопов. На странице франшизы сеть пишет о более чем 200 филиалах в нескольких странах и упоминает, что за последний год закрыла 22 точки, не соответствовавшие стандарту.</p>
<p>По открытым данным, которые приводило BFM, франшиза TOPGUN стоит 2–2,5 млн ₽, паушальный взнос — от 500 тыс. до 1 млн ₽, роялти — 5%. В каталоге франшиз Topfranchise общие вложения указаны от 5,5 млн ₽, срок окупаемости — от 14 месяцев.</p>

<h2>OldBoy</h2>
<p>OldBoy позиционирует себя как крупную международную сеть с атмосферой 1930-х годов. На странице франшизы сеть пишет о более чем 100 филиалах и примерно 60 открытиях за последний год. В подборке франшиз «Т-Бизнес секретов» годовая выручка филиала OldBoy указана в диапазоне 10–40 млн ₽.</p>

<h2>Borodach</h2>
<p>В феврале 2026 года сооснователь Borodach Антон Василенко запустил сеть мужских lifestyle-магазинов «Стильхаб». Сама сеть барбершопов, по данным New Retail, насчитывает более 140 локаций. В 2023 году Borodach открылся в Дубае, а к концу 2024-го, по данным самой сети, её клиентами были более 200 тыс. мужчин.</p>

<h2>Chop-Chop и BarbarossA</h2>
<p>Chop-Chop делает ставку на доступные мужские парикмахерские и широкую географию: в нашем каталоге филиалы сети есть в 56 городах — больше, чем у любой другой. BarbarossA, по словам сооснователя в колонке для Inc. Russia, насчитывает 68 салонов в России и странах СНГ, включая Казахстан и Сербию.</p>

<h2>Сети в каталоге TOP BARBERSHOP</h2>
<p>Карточки в каталоге не равны полному размеру сети: часть филиалов ещё не добавлена. Но таблица показывает, у кого шире география.</p>
<table>
<thead><tr><th>Сеть</th><th>Карточек</th><th>Городов</th></tr></thead>
<tbody>
<tr><td><a href="/all/topgun/">TopGun</a></td><td>185</td><td>34</td></tr>
<tr><td><a href="/all/oldboy/">OldBoy</a></td><td>101</td><td>25</td></tr>
<tr><td><a href="/all/britva/">Britva</a></td><td>87</td><td>11</td></tr>
<tr><td><a href="/all/chop-chop/">Chop Chop</a></td><td>81</td><td>56</td></tr>
<tr><td><a href="/all/borodach/">Borodach</a></td><td>61</td><td>28</td></tr>
<tr><td><a href="/all/barbarossa/">BarbarossA</a></td><td>38</td><td>19</td></tr>
<tr><td><a href="/all/big-bro/">Big Bro</a></td><td>30</td><td>28</td></tr>
</tbody>
</table>
<p>Полный список — на странице <a href="/samye-krupnye-seti-barbershopov/">«Самые крупные сети барбершопов»</a>.</p>

<h2>Куда движутся сети</h2>
<ul>
<li><b>Франшиза — главный двигатель роста.</b> Собственные точки остаются у основателей, а новые города открывают партнёры.</li>
<li><b>Качество важнее количества.</b> Сети закрывают слабые точки, чтобы не портить бренд.</li>
<li><b>Выход за пределы стрижки.</b> Собственная косметика, школы барберов, магазины и смежные услуги помогают зарабатывать больше с каждого клиента.</li>
<li><b>Независимые барбершопы никуда не исчезают.</b> Около половины заведений в каталоге не входят ни в одну сеть и конкурируют атмосферой и мастерами.</li>
</ul>
<p>Если вы владелец сети или отдельного барбершопа, <a href="/add/">добавьте свои филиалы в каталог</a> — клиенты ищут барбершоп по городу и станции метро.</p>
<h2>Источники</h2><ul class="sources"><li><a href="https://www.sostav.ru/blogs/274785/60530" rel="nofollow noopener" target="_blank">TOPGUN: о провокациях, индустрии, деньгах и стиле — Sostav</a></li><li><a href="https://businessmens.ru/franchise/topgun-barbershop-814" rel="nofollow noopener" target="_blank">Франшиза барбершопа TOPGUN — Businessmens</a></li><li><a href="https://www.bfm.ru/news/584488" rel="nofollow noopener" target="_blank">В России вырос спрос на франшизы в сфере бьюти-услуг — BFM</a></li><li><a href="https://topfranchise.ru/products/franshiza-muzhskoy-parikmakherskoy-topgun-barbershop/" rel="nofollow noopener" target="_blank">Франшиза ТОПГАН — Topfranchise</a></li><li><a href="https://topfranchise.ru/products/franshiza-barbershopa-oldboy/" rel="nofollow noopener" target="_blank">Франшиза барбершопа OldBoy — Topfranchise</a></li><li><a href="https://new-retail.ru/novosti/retail/v_rossii_poyavitsya_pervyy_muzhskoy_lifestyle_riteyler/" rel="nofollow noopener" target="_blank">Сеть барбершопов Borodach откроет сеть мужских lifestyle-магазинов — New Retail</a></li><li><a href="https://topfranchise.ru/products/franshiza-muzhskoy-parikmakherskoy-barbershop-borodach/" rel="nofollow noopener" target="_blank">Франшиза BORODACH — Topfranchise</a></li><li><a href="https://incrussia.ru/share/rynok-barbershopov/" rel="nofollow noopener" target="_blank">Как устроена индустрия барбершопов в России — Inc. Russia</a></li></ul>$c$, 'TOPGUN, OldBoy, Borodach, Chop-Chop, BarbarossA — сети, на которых вырос российский рынок барбершопов. Рассказываем, сколько у них точек, сколько стоит франшиза и как сети меняют стратегию.', '/media/2026/04/krupnejshie-seti-barbershopov-rossii-2026.jpg', 5064, 'Крупнейшие сети барбершопов России 2026: TOPGUN, OldBoy, Borodach', 'TOPGUN, OldBoy, Borodach, Chop-Chop, BarbarossA и другие: сколько у сетей филиалов, как они растут по франшизе и сколько стоит войти в сеть.', false, '2026-04-14 10:00:00+03', '2026-04-14 10:00:00+03'
on conflict (slug) do update set title=excluded.title, content=excluded.content, excerpt=excluded.excerpt, cover_image=excluded.cover_image, seo_title=excluded.seo_title, seo_description=excluded.seo_description, status='published', published_at=excluded.published_at, updated_at=excluded.updated_at;
insert into post_categories (post_id, category_id) select p.id, c.id from posts p, categories c where p.slug='krupnejshie-seti-barbershopov-rossii-2026' and c.slug='stati' and not exists (select 1 from post_categories x where x.post_id=p.id and x.category_id=c.id);
insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='barbershopy-pervyj-kvartal-2026'), (select max(id)+1 from posts)), 'barbershopy-pervyj-kvartal-2026', 'Барбершопы в начале 2026 года: чек растёт, клиентов меньше', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>По данным Т-Банка, в I квартале 2026 года чеков в сетевых барбершопах стало на 22% меньше, а средний чек вырос на 14% — до 1 972 ₽.</li><li>В Петербурге, по фискальным данным «Эвотора», чек вырос на 16% (до 2 256 ₽), а выручка средней точки снизилась на 16%.</li><li>При этом барбершопов в миллионниках стало на 11% больше — конкуренция растёт.</li><li>Причины: мужчины реже стригутся, уходят в эконом- и средний сегмент, бизнес давит налоговая реформа.</li></ul></div>
<p>Весной 2026 года сразу несколько источников показали, что барбершопы входят в непростой период. Цены продолжают расти, но гостей становится меньше. Разберём, что говорят цифры и сами владельцы.</p>

<h2>Что показывают данные</h2>
<table>
<thead><tr><th>Источник</th><th>Показатель</th><th>I кв. 2026 к I кв. 2025</th></tr></thead>
<tbody>
<tr><td>Т-Банк (исследование Shopper’s, крупные сети)</td><td>Число чеков</td><td>−22%</td></tr>
<tr><td>Т-Банк (крупные сети)</td><td>Средний чек</td><td>+14%, с 1 729 до 1 972 ₽</td></tr>
<tr><td>«Эвотор», Петербург</td><td>Средний чек</td><td>+16%, до 2 256 ₽</td></tr>
<tr><td>«Эвотор», Петербург</td><td>Чеков на точку</td><td>−28%</td></tr>
<tr><td>«Эвотор», Петербург</td><td>Выручка точки</td><td>−16%</td></tr>
<tr><td>YCLIENTS, Петербург, март</td><td>Средний чек / записи</td><td>+16% (2 096 ₽) / +9,1%</td></tr>
</tbody>
</table>
<p>Цифры расходятся из-за разных выборок: кассы и банк видят все платежи своих клиентов, а сервис записи — только онлайн-записи. Но общая картина понятна: каждый клиент платит больше, а самих клиентов у многих точек стало меньше.</p>
<p>В выборку Т-Банка вошли крупные сети, в том числе «Супермен», TOPGUN, Borodach, OldBoy, Chop-Chop, «Франт», «Мужики про», Fidel, Britva, Big Bro и BarbarossA.</p>

<h2>Число барбершопов всё равно растёт</h2>
<p>Парадокс в том, что точек становится больше. По данным 2ГИС, на апрель 2026 года в городах-миллионниках работало более 4,7 тыс. барбершопов — на 11% больше, чем годом ранее. В Петербурге их больше 850, рост за год — 8%. Клиентов делят между собой всё больше заведений.</p>

<h2>Почему клиентов меньше</h2>
<p>Владельцы, с которыми говорили «Фонтанка» и «Деловой Петербург», называют несколько причин:</p>
<ul>
<li><b>Мужчины реже стригутся.</b> Управляющий одной из петербургских сетей Кирилл Федченко говорит, что интервал между визитами вырос примерно с трёх до четырёх-пяти недель.</li>
<li><b>Клиенты переходят в более дешёвый сегмент:</b> из премиальных барбершопов — в средний, из средних — в эконом-формат.</li>
<li><b>Доходы и расходы.</b> Мужчины начали экономить на регулярных услугах.</li>
<li><b>Налоговая реформа.</b> Часть салонов закрылась ещё в конце 2025 года, не желая работать с НДС.</li>
</ul>
<p>По словам Федченко, в его сети посещаемость в январе 2026 года упала на 29% к январю 2025-го, а по итогам квартала — на 16%. За весь 2025 год, по его оценке, барбершопы потеряли около 13,7% посещаемости, и это системный тренд с 2024 года, не связанный с ростом цен.</p>

<h2>Маржа и прогнозы</h2>
<p>Основатель салона Skalptura Даниил Марков рассказал «Фонтанке», что в 2024 — начале 2025 года хорошей считалась маржа около 20%, а теперь — 10–12%. Президент Ассоциации индустрии красоты Ляля Садыкова оценила долю барбершопов в салонном рынке 2025 года примерно в 20%. Объём рынка барбершопов Федченко оценивает в 10–15 млрд ₽ в год.</p>
<p>Эксперты «Делового Петербурга» допускают, что до конца года в городе может закрыться до 20% барбершопов.</p>

<h2>Кто выиграет</h2>
<ul>
<li><b>Те, у кого есть своё лицо:</b> специализация (например, длинные стрижки), атмосфера, сильные мастера.</li>
<li><b>Те, кто удерживает постоянных гостей:</b> напоминания о повторном визите, программы лояльности, удобная онлайн-запись.</li>
<li><b>Те, кого легко найти.</b> Когда клиент выбирает между десятком барбершопов у метро, выигрывает тот, у кого понятная карточка с ценами, фото и кнопкой записи.</li>
</ul>
<p>Владельцам барбершопов: <a href="/add/">добавьте свой барбершоп в каталог</a> бесплатно. С тарифом PRO в карточке появятся телефон, сайт и кнопка онлайн-записи — подробности на странице <a href="/tarify/">«Тарифы»</a>.</p>
<h2>Источники</h2><ul class="sources"><li><a href="https://www.fontanka.ru/2026/04/26/76388052/" rel="nofollow noopener" target="_blank">Расти, борода. Почему барбершопы теряют клиентов — Фонтанка</a></li><li><a href="https://www.dp.ru/a/2026/04/26/v-peterburge-do-konca-2026" rel="nofollow noopener" target="_blank">Барбершопы Петербурга недосчитались клиентов — Деловой Петербург</a></li></ul>$c$, 'В первом квартале 2026 года количество чеков в сетевых барбершопах упало на 22%, а средний чек вырос на 14%. Собрали данные банков, касс и сервисов записи и объясняем, почему одни барбершопы теряют клиентов, а число точек продолжает расти.', '/media/2026/05/barbershopy-pervyj-kvartal-2026.jpg', 5064, 'Барбершопы в I квартале 2026: почему клиентов меньше, а чек выше', 'В I квартале 2026 года чеков в сетевых барбершопах стало на 22% меньше, а средний чек вырос на 14%. Разбираем данные Т-Банка, Эвотора, YCLIENTS и 2ГИС.', false, '2026-05-19 10:00:00+03', '2026-05-19 10:00:00+03'
on conflict (slug) do update set title=excluded.title, content=excluded.content, excerpt=excluded.excerpt, cover_image=excluded.cover_image, seo_title=excluded.seo_title, seo_description=excluded.seo_description, status='published', published_at=excluded.published_at, updated_at=excluded.updated_at;
insert into post_categories (post_id, category_id) select p.id, c.id from posts p, categories c where p.slug='barbershopy-pervyj-kvartal-2026' and c.slug='novosti' and not exists (select 1 from post_categories x where x.post_id=p.id and x.category_id=c.id);
insert into posts (id, slug, title, status, content, excerpt, cover_image, author_id, seo_title, seo_description, noindex, published_at, updated_at)
select coalesce((select id from posts where slug='zarplata-barbera-2026'), (select max(id)+1 from posts)), 'zarplata-barbera-2026', 'Сколько зарабатывает барбер в 2026 году', 'published', $c$<div class="tldr"><p><b>Коротко</b></p><ul><li>В мае 2026 года средняя зарплата барбера в Москве составила около 114,5 тыс. ₽, по данным «ГородРабот.ру».</li><li>По данным YCLIENTS, за год до марта 2025-го зарплата барберов выросла на 17,4% — быстрее, чем у других бьюти-мастеров.</li><li>Мастер обычно получает 35–45% от стоимости услуги; к этому добавляются проценты с продажи косметики.</li><li>Из-за дефицита кадров работодатели чаще берут барберов без опыта.</li></ul></div>
<p>Профессия барбера за десять лет прошла путь от экзотики до одной из самых востребованных в индустрии красоты. Мастеров не хватает, и это видно по зарплатам: они растут быстрее, чем в целом по рынку.</p>

<h2>Сколько платят</h2>
<table>
<thead><tr><th>Источник и период</th><th>Показатель</th></tr></thead>
<tbody>
<tr><td>YCLIENTS, март 2025, Россия</td><td>85,5 тыс. ₽ в месяц, +17,4% за год</td></tr>
<tr><td>«Авито Работа», апрель 2025, Татарстан</td><td>103,5 тыс. ₽ в вакансиях; число вакансий +56% за год</td></tr>
<tr><td>«ГородРабот.ру», май 2026, Москва</td><td>114,5 тыс. ₽ в месяц</td></tr>
</tbody>
</table>
<p>Для сравнения: по данным «Авито Работы», «Авито Услуг» и сети «Улыбка радуги» за III квартал 2025 года, парикмахерам в среднем предлагали 109 тыс. ₽ — на 37% больше, чем годом ранее. По данным Seldon, в Москве средняя предлагаемая зарплата парикмахера в 2025 году составляла 133,9 тыс. ₽.</p>
<p>Средние цифры по вакансиям не равны реальному доходу: опытный барбер с постоянной клиентурой в сильном барбершопе зарабатывает заметно больше, начинающий — меньше.</p>

<h2>Из чего складывается доход</h2>
<ul>
<li><b>Процент с услуг.</b> По данным Inc. Russia, фонд оплаты мастеров обычно составляет 35–45% выручки. В журнале «Контура» приводят пример: со стрижки за 3 000 ₽ мастер получает около 1 200 ₽, а работодателю это обходится примерно в 1 800 ₽ с налогами и взносами.</li>
<li><b>Продажа косметики.</b> Многие барбершопы платят мастеру процент с проданных средств для укладки и ухода.</li>
<li><b>Аренда кресла.</b> Часть опытных барберов работает как самозанятые или ИП: арендуют кресло и забирают выручку себе, но сами ищут клиентов.</li>
<li><b>Постоянные гости.</b> Чем больше клиентов возвращается к конкретному мастеру, тем плотнее его запись и выше доход.</li>
</ul>

<h2>Почему барберов не хватает</h2>
<p>Спрос на услуги растёт быстрее, чем количество мастеров. По данным «Авито», в 2025 году интерес к услугам барберов вырос на 34%. По данным hh.ru, в январе–апреле 2025 года 17% вакансий в бьюти-сфере были открыты для специалистов без опыта — на 1,2 процентного пункта больше, чем годом ранее. Работодатели готовы доучивать новичков, лишь бы закрыть кресла.</p>

<h2>Как стать барбером</h2>
<ol>
<li><b>Пройти обучение.</b> Базовый курс мужской стрижки длится от нескольких недель до пары месяцев. Многие сети открывают собственные школы — посмотрите <a href="/school/">школы барберов</a> в нашем каталоге.</li>
<li><b>Набрать практику.</b> Первые месяцы уходят на скорость и отработку классических стрижек, фейдов и оформления бороды.</li>
<li><b>Найти место.</b> Начинающим проще устроиться в сеть, где есть поток клиентов и наставники. Актуальные предложения — в разделе <a href="/vacancy/">«Вакансии»</a>.</li>
<li><b>Собрать своих клиентов.</b> Портфолио в соцсетях и сарафанное радио — главный источник роста дохода.</li>
</ol>
<h2>Источники</h2><ul class="sources"><li><a href="https://www.kommersant.ru/doc/7711286" rel="nofollow noopener" target="_blank">Зарплаты барберов и средний чек салонов — Коммерсантъ</a></li><li><a href="https://topfranchise.ru/catalog/franshizy-muzhskikh-parikmakherskikh-barbershop/" rel="nofollow noopener" target="_blank">Франшизы барбершопов: средняя зарплата барбера в Москве — Topfranchise</a></li><li><a href="https://www.evening-kazan.ru/obshhestvo/news/v-tatarstane-v-preddverii-leta-vozros-spros-na-barberov" rel="nofollow noopener" target="_blank">В Татарстане возрос спрос на барберов — Вечерняя Казань</a></li><li><a href="https://media.halvacard.ru/finance/skolko-zarabatyvaiut-parikmaxery" rel="nofollow noopener" target="_blank">Сколько зарабатывают парикмахеры — Халва Медиа</a></li><li><a href="https://finance.mail.ru/article/zarplaty-barberov-v-rf-rastut-bystree-drugih-specialistov-byuti-industrii-66037610/" rel="nofollow noopener" target="_blank">Зарплаты барберов растут быстрее других специалистов — Mail Финансы</a></li><li><a href="https://kontur.ru/articles/347" rel="nofollow noopener" target="_blank">Повышение НДС в 2026 году и бьюти-рынок — Контур</a></li><li><a href="https://incrussia.ru/share/rynok-barbershopov/" rel="nofollow noopener" target="_blank">Как устроена индустрия барбершопов в России — Inc. Russia</a></li></ul>$c$, 'Зарплаты барберов уже второй год растут быстрее, чем у других мастеров индустрии красоты. Разбираемся, сколько зарабатывают барберы в Москве и регионах, из чего складывается доход и почему работодатели всё охотнее берут новичков.', '/media/2026/06/zarplata-barbera-2026.jpg', 5064, 'Зарплата барбера в 2026 году: сколько зарабатывают мастера', 'Средняя зарплата барбера в Москве в мае 2026 года — около 114,5 тыс. ₽. Как растут доходы, сколько процентов получает мастер и почему барберов не хватает.', false, '2026-06-16 10:00:00+03', '2026-06-16 10:00:00+03'
