---
import AccountLayout from '../components/AccountLayout.astro';
import '../styles/forms.css';
import { sql } from '../lib/db';
import { verifyLogin, hashPassword } from '../lib/auth';
import { sameOrigin, str } from '../lib/forms';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login/?next=/change-password/');
let err = '', ok = false;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const pw = str(f, 'password', 200);
  if (!sameOrigin(Astro.request)) err = 'Обновите страницу.';
  else if (!(await verifyLogin(user.email || user.login || '', str(f, 'old', 200)))) err = 'Текущий пароль указан неверно.';
  else if (pw.length < 8) err = 'Новый пароль — не короче 8 символов.';
  else { await sql`update site_users set pass_hash = ${hashPassword(pw)} where id = ${user.id}`; ok = true; }
}
---
<AccountLayout title="Смена пароля" active="/change-password/">
  {err && <p class="msg err">{err}</p>}
  {ok && <p class="msg ok">Пароль изменён.</p>}
  <form method="post" class="frm narrow">
    <label>Текущий пароль <input class="field" name="old" type="password" required autocomplete="current-password" /></label>
    <label>Новый пароль <input class="field" name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
    <div><button class="btn brass">Сохранить</button></div>
  </form>
</AccountLayout>
