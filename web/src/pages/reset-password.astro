---
import AccountLayout from '../components/AccountLayout.astro';
import '../styles/forms.css';
import { sql } from '../lib/db';
import { sha, hashPassword, createSession } from '../lib/auth';
import { sameOrigin, str } from '../lib/forms';
const t = Astro.url.searchParams.get('t') || '';
const [r] = t ? await sql`select user_id from password_resets where token = ${sha(t)} and not used and expires_at > now()` : [];
let err = '';
if (r && Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const pw = str(f, 'password', 200);
  if (!sameOrigin(Astro.request)) err = 'Обновите страницу.';
  else if (pw.length < 8) err = 'Пароль — не короче 8 символов.';
  else {
    await sql`update site_users set pass_hash = ${hashPassword(pw)} where id = ${r.user_id}`;
    await sql`update password_resets set used = true where token = ${sha(t)}`;
    await sql`delete from sessions where user_id = ${r.user_id}`;
    await createSession(Astro.cookies, r.user_id, Astro.request);
    return Astro.redirect('/my/');
  }
}
---
<AccountLayout title="Новый пароль">
  {!r ? <p class="msg err">Ссылка устарела или уже использована. <a href="/lost-password/">Запросите новую</a>.</p> : (
    <>
      {err && <p class="msg err">{err}</p>}
      <form method="post" class="frm narrow">
        <label>Новый пароль <input class="field" name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
        <div><button class="btn brass">Сохранить и войти</button></div>
      </form>
    </>
  )}
</AccountLayout>
