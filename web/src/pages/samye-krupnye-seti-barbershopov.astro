---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { sql } from '../lib/db';
import { img } from '../lib/img';
import { breadcrumbLd } from '../lib/seo';
import { shops, strip, clip } from '../lib/text';
const chains = await sql`select c.slug, c.name, c.image, c.description, count(b.id)::int n, count(distinct b.location_id)::int cities from chains c join barbershops b on b.chain_id = c.id and b.status='published' where c.name ~ '[[:alpha:]]' group by c.id order by n desc, c.name`;
const crumbs: [string, string?][] = [['Главная', '/'], ['Сети барбершопов']];
---
<Base title="Самые крупные сети барбершопов России — рейтинг по числу филиалов" description="Крупнейшие сети барбершопов: OldBoy, Chop-Chop, TopGun, BoyCut, Frisor и другие. Сколько филиалов, в каких городах, адреса и цены." jsonLd={breadcrumbLd(crumbs)}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <h1>Самые крупные сети барбершопов</h1>
    <p class="muted">Сети упорядочены по числу филиалов в нашем каталоге.</p>
    <ol class="nets">
      {chains.map((c) => (
        <li class="panel net">
          {c.image ? <img src={img(c.image, 160, 160, 'fit')} alt="" width="72" height="72" loading="lazy" onerror="this.remove()" /> : <span class="net-l">{c.name.slice(0, 1)}</span>}
          <div><h2><a href={`/all/${c.slug}/`}>{c.name}</a></h2><p class="muted">{shops(c.n)} · городов: {c.cities}</p>{c.description && <p>{clip(strip(c.description), 220)}</p>}</div>
        </li>
      ))}
    </ol>
  </div>
</Base>
<style>
.nets{list-style:none;padding:0;display:grid;gap:12px}
.net{display:flex;gap:18px;align-items:flex-start}.net>div{min-width:0}
.net img,.net-l{width:72px;height:72px;border-radius:12px;object-fit:contain;background:var(--paper);flex:none}
.net-l{display:grid;place-items:center;font-weight:800;font-size:28px;color:var(--brass)}
.net h2{font-size:22px;margin:0 0 2px}.net h2 a{text-decoration:none}.net p{margin:4px 0 0}
</style>
