---
import Journal from '../../components/Journal.astro';
import { sql } from '../../lib/db';
import { splitPage } from '../../lib/catalog';
import { listPosts, usedCats } from '../../lib/journal';
import { strip, clip } from '../../lib/text';
const { parts, page } = splitPage(Astro.params.p);
const slug = parts[parts.length - 1];
const [c] = slug ? await sql`select * from categories where slug = ${slug}` : [];
if (!c) return Astro.rewrite('/404/');
const { posts, pages } = await listPosts(sql`p.id in (select post_id from post_categories where category_id = ${c.id})`, page);
if (page > pages) return Astro.rewrite('/404/');
const cats = await usedCats();
---
<Journal h1={c.name} title={c.seo_title || `${c.name} — журнал TOP BARBERSHOP`} description={clip(strip(c.description) || `Статьи рубрики «${c.name}» в журнале TOP BARBERSHOP о мужских стрижках, бритье и уходе.`, 200)} crumbs={[['Главная', '/'], ['Журнал', '/zhurnal/'], [c.name]]} base={`/category/${c.slug}/`} {page} {posts} {pages} {cats} />
