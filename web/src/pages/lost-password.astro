---
import AccountLayout from '../components/AccountLayout.astro';
import '../styles/forms.css';
import { sql } from '../lib/db';
import { token, sha } from '../lib/auth';
import { sendMail, mailEnabled } from '../lib/mail';
import { rateLimited, ipOf, sameOrigin, str } from '../lib/forms';
let done = false, err = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const email = str(f, 'email', 120).toLowerCase();
  if (!sameOrigin(Astro.request) || rateLimited('lost:' + ipOf(Astro.request), 5, 3600)) err = 'Слишком много запросов. Попробуйте позже.';
  else {
    const [u] = await sql`select id, email from site_users where lower(email) = ${email} or lower(login) = ${email} limit 1`;
    if (u?.email) {
      const t = token();
      await sql`insert into password_resets (token, user_id, expires_at) values (${sha(t)}, ${u.id}, now() + interval '2 hours')`;
      await sendMail(u.email, 'Восстановление пароля — TOP BARBERSHOP', `Здравствуйте!\n\nЧтобы задать новый пароль, перейдите по ссылке (действует 2 часа):\nhttps://top-barbershop.com/reset-password/?t=${t}\n\nЕсли вы не запрашивали восстановление, просто проигнорируйте это письмо.\n\nTOP BARBERSHOP`);
    }
    done = true; // не сообщаем, есть ли такой адрес
  }
}
---
<AccountLayout title="Восстановление пароля">
  {!mailEnabled && <p class="msg err">Отправка писем временно не работает. Напишите нам во <a href="https://vk.com/im?sel=510233" target="_blank" rel="noopener">ВКонтакте</a> — поможем восстановить доступ.</p>}
  {err && <p class="msg err">{err}</p>}
  {done ? <p class="msg ok">Если такой аккаунт есть, мы отправили на него письмо со ссылкой. Проверьте почту и папку «Спам».</p> : (
    <form method="post" class="frm narrow">
      <label>E-mail или логин <input class="field" name="email" required autocomplete="email" /></label>
      <div><button class="btn brass">Получить ссылку</button></div>
      <p class="alt"><a href="/login/">Вспомнили пароль?</a></p>
    </form>
  )}
</AccountLayout>
