---
import AccountLayout from '../../components/AccountLayout.astro';
import { sql } from '../../lib/db';
import { SELLER, loadOrder, orderTitle, paymentsEnabled, priorityAlive, startPayment } from '../../lib/billing';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login/?next=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
const isAdmin = ['administrator', 'editor'].includes(user.role || '');
const id = Number(Astro.url.searchParams.get('order')) || 0;
const o = id ? await loadOrder(id) : null;
const mine = o && (o.user_id === user.id || isAdmin);

let state: 'pay' | 'none' | 'cancelled' | 'expired' | 'off' | 'error' = 'none';
let link = '';
const what = mine ? orderTitle(o) : '';
if (mine) {
  if (o.status === 'paid') return Astro.redirect(`/billing/?paid=${o.id}`);
  if (o.status === 'cancelled') state = 'cancelled';
  else if (!priorityAlive(o)) {
    state = 'expired';
    await sql`update orders set status = 'cancelled' where id = ${o.id} and status = 'pending'`;
  } else if (!paymentsEnabled) state = 'off';
  else {
    const p = await startPayment(o, `TOP BARBERSHOP: ${what}`, user.email).catch(() => null);
    if (p && 'paid' in p) return Astro.redirect(`/billing/?paid=${o.id}`);
    if (p && 'url' in p && p.url) { link = p.url; state = 'pay'; }
    else state = 'error';
  }
}
---
<AccountLayout title="Оплата заказа" active="/billing/">
  {!mine && <div class="panel pay"><p>Заказ не найден. Все ваши заказы — в разделе <a href="/billing/">«Тариф и продвижение»</a>.</p></div>}
  {mine && (
    <div class="panel pay">
      <p class="eyebrow">Заказ №{o.id}</p>
      <h2>{what}</h2>
      <p class="sum">{o.amount.toLocaleString('ru-RU')} ₽{o.discount ? <small class="muted"> · скидка {o.discount}%</small> : null}</p>
      {state === 'pay' && Astro.url.searchParams.has('retry') && <p class="msg err">Оплата не прошла. Попробуйте ещё раз или выберите другой способ.</p>}
      {state === 'pay' && link && (
        <>
          <p><a class="btn brass" href={link} rel="nofollow">Оплатить {o.amount.toLocaleString('ru-RU')} ₽</a></p>
          <p class="alt">Откроется защищённая страница оплаты Точка Банка: картой, через СБП или T-Pay. Данные карты на наш сайт не попадают. Услуга включится сразу после оплаты.</p>
        </>
      )}
      {state === 'cancelled' && <p class="msg err">Заказ отменён. Оформите новый в разделе <a href="/billing/">«Тариф и продвижение»</a>.</p>}
      {state === 'expired' && <p class="msg err">Бронь недели в топе города истекла: неоплаченное место держится 48 часов. Выберите неделю заново в разделе <a href="/billing/">«Тариф и продвижение»</a>.</p>}
      {state === 'off' && <p class="msg ok">Онлайн-оплата временно недоступна. Мы пришлём счёт на {user.email} в течение рабочего дня.</p>}
      {state === 'error' && <p class="msg err">Не удалось открыть оплату. Обновите страницу через минуту или напишите нам: <a href={`mailto:${SELLER.email}`}>{SELLER.email}</a>.</p>}
      <p class="alt" style="margin-top:16px"><a href="/billing/">← Вернуться к тарифам</a> · Продавец: {SELLER.name}, ИНН {SELLER.inn}. <a href="/oferta/">Оферта</a>.</p>
    </div>
  )}
</AccountLayout>
<style>
.pay{max-width:720px}.pay h2{margin:2px 0 6px;font-size:22px}.sum{font-size:28px;font-weight:700;margin:0 0 16px}
</style>
