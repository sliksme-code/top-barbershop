---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { breadcrumbLd, abs } from '../../lib/seo';
import { TYPES, typeUrl } from '../../lib/cosmetics';
import { HAIRCUTS, HAIRCUT_ORDER, FACES, FACE_ORDER, LEN_LABEL, HUB_PHOTO, photoUrl, haircutUrl, faceUrl, type Face, type Haircut } from '../../lib/haircuts';

const parts = (Astro.params.path ?? '').split('/').filter(Boolean);
const root: [string, string?] = ['Причёски', '/pricheski/'];
let crumbs: [string, string?][] = [['Главная', '/']];
let view = '', title = '', description = '', h1 = '';
let slug = '', face: Face | '' = '';
const ld: any[] = [];

if (parts.length === 0) {
  view = 'hub'; crumbs.push(['Причёски']);
  h1 = 'Мужские стрижки: гид по причёскам';
  title = 'Мужские стрижки: названия, фото, история и кому подходят — гид';
  description = '23 мужские стрижки с фото: андеркат, помпадур, фейд, кроп, бокс, канадка, флоу и другие. История, описание, подходящая форма лица и укладка.';
} else if (parts[0] === 'forma-lica' && parts.length === 1) {
  view = 'faces'; crumbs.push(root, ['Форма лица']);
  h1 = 'Как подобрать стрижку по форме лица';
  title = 'Как подобрать мужскую стрижку по форме лица: 7 типов и примеры';
  description = 'Как определить форму лица за минуту и какие мужские стрижки подходят овальному, круглому, квадратному, вытянутому, треугольному, ромбовидному и сердцевидному лицу.';
} else if (parts[0] === 'forma-lica' && parts.length === 2 && (FACE_ORDER as string[]).includes(parts[1])) {
  view = 'face'; face = parts[1] as Face;
  const f = FACES[face];
  crumbs.push(root, ['Форма лица', '/pricheski/forma-lica/'], [f.name]);
  h1 = `Мужские стрижки для ${f.gen} лица`;
  title = `Стрижки для ${f.gen} лица мужчине: что подходит и чего избегать`;
  description = `${f.goal} Подборка стрижек с фото для ${f.gen} лица и советы, чего избегать.`.slice(0, 190);
} else if (parts.length === 1 && HAIRCUTS[parts[0]]) {
  view = 'cut'; slug = parts[0];
  const c = HAIRCUTS[slug];
  crumbs.push(root, [c.name]);
  const nm = c.name.startsWith('Мужское') ? c.name : `Стрижка ${c.name.toLowerCase()}`;
  h1 = nm;
  title = `${nm}: фото, история, кому подходит и как укладывать`;
  description = `${c.summary} История стрижки ${c.name.toLowerCase()}, подходящие формы лица, как объяснить барберу и как укладывать.`.slice(0, 190);
}
if (!view) return Astro.rewrite('/404/');
ld.push(breadcrumbLd(crumbs));

const c: Haircut | null = slug ? HAIRCUTS[slug] : null;
if (c) {
  ld.push({ '@context': 'https://schema.org', '@type': 'Article', headline: h1, description, image: abs(photoUrl(c.photo.file)), inLanguage: 'ru', author: { '@type': 'Organization', name: 'TOP BARBERSHOP', url: abs('/') }, publisher: { '@type': 'Organization', name: 'TOP BARBERSHOP' }, mainEntityOfPage: abs(haircutUrl(slug)) });
  ld.push({ '@context': 'https://schema.org', '@type': 'HowTo', name: `Как уложить стрижку ${c.name.toLowerCase()}`, step: c.styling.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })) });
}
const list = (keys: string[]) => keys.filter((k) => HAIRCUTS[k]).map((k) => [k, HAIRCUTS[k]] as const);
const forFace = face ? list(HAIRCUT_ORDER.filter((k) => HAIRCUTS[k].fits.includes(face as Face))) : [];
const notFace = face ? list(HAIRCUT_ORDER.filter((k) => HAIRCUTS[k].avoid.includes(face as Face))) : [];
if (view === 'face' || view === 'hub') {
  const items = view === 'hub' ? list(HAIRCUT_ORDER) : forFace;
  ld.push({ '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: items.map(([k, h], i) => ({ '@type': 'ListItem', position: i + 1, url: abs(haircutUrl(k)), name: `Стрижка ${h.name.toLowerCase()}` })) });
}
const FACE_SVG: Record<Face, string> = {
  oval: '<ellipse cx="30" cy="40" rx="19" ry="30"/>',
  kruglaya: '<ellipse cx="30" cy="41" rx="24" ry="26"/>',
  kvadratnaya: '<rect x="8" y="12" width="44" height="56" rx="9"/>',
  vytyanutaya: '<rect x="13" y="4" width="34" height="72" rx="13"/>',
  treugolnaya: '<path d="M21 8h18q10 30 13 56q-22 16-44 0q3-26 13-56z"/>',
  romb: '<path d="M30 4q16 16 24 36q-8 20-24 36q-16-16-24-36q8-20 24-36z"/>',
  serdce: '<path d="M7 18q23-18 46 0q2 26-23 58q-25-32-23-58z"/>',
};
const card = (k: string, h: Haircut) => ({ k, h });
const byLen = (l: string) => list(HAIRCUT_ORDER.filter((k) => HAIRCUTS[k].len === l));
---
<Base {title} {description} jsonLd={ld}>
  <div class="wrap prc">
    <Crumbs items={crumbs} />

    {view === 'hub' && (
      <>
        <div class="hero">
          <div>
            <h1>{h1}</h1>
            <p class="lead">23 мужские стрижки: как они выглядят, откуда пришли, кому подходят и как их укладывать. Выберите стрижку по названию или начните с формы лица.</p>
            <p><a class="btn brass" href="/pricheski/forma-lica/">Подобрать по форме лица</a></p>
          </div>
          <figure class="hero-ph"><img src={photoUrl(HUB_PHOTO.file)} alt={HUB_PHOTO.alt} width={HUB_PHOTO.w} height={HUB_PHOTO.h} /><figcaption>Фото: <a href={`https://unsplash.com/photos/${HUB_PHOTO.id}`} rel="nofollow noopener" target="_blank">{HUB_PHOTO.author}</a> / Unsplash</figcaption></figure>
        </div>
        <h2>Форма лица</h2>
        <div class="faces">{FACE_ORDER.map((f) => <a class="face" href={faceUrl(f)}><svg viewBox="0 0 60 80" aria-hidden="true" set:html={FACE_SVG[f]} /><span>{FACES[f].name}</span></a>)}</div>
        {(['short', 'medium', 'long'] as const).map((l) => (
          <>
            <h2>{LEN_LABEL[l]} стрижки</h2>
            <div class="cuts">{byLen(l).map(([k, h]) => (
              <a class="cut" href={haircutUrl(k)}>
                <img src={photoUrl(h.photo.file)} alt={h.photo.alt} width={h.photo.w} height={h.photo.h} loading="lazy" />
                <b>{h.name}</b><span class="muted">{h.summary}</span>
              </a>
            ))}</div>
          </>
        ))}
        <h2>Сводная таблица</h2>
        <div class="tbl"><table>
          <thead><tr><th>Стрижка</th><th>Сверху</th><th>Бока</th><th>Обновлять</th><th>Форма лица</th></tr></thead>
          <tbody>{list(HAIRCUT_ORDER).map(([k, h]) => <tr><td><a href={haircutUrl(k)}>{h.name}</a></td><td>{h.top}</td><td>{h.sides}</td><td>{h.care}</td><td>{h.fits.map((f) => FACES[f].short.toLowerCase()).join(', ')}</td></tr>)}</tbody>
        </table></div>
        <div class="panel cta"><h2>Найдите барбера</h2><p>Покажите мастеру фото выбранной стрижки — так проще договориться о длине и переходе. <a href="/listings/">Барбершопы в вашем городе →</a></p></div>
      </>
    )}

    {view === 'faces' && (
      <>
        <h1>{h1}</h1>
        <p class="lead">Форма лица подсказывает, где стрижке нужен объём, а где его лучше убрать. Но это не строгое правило: тип волос, борода и образ жизни важны не меньше.</p>
        <h2>Как определить форму лица</h2>
        <ol>
          <li>Зачешите волосы назад и встаньте перед зеркалом.</li>
          <li>Сравните ширину лба, скул и нижней челюсти: какая часть самая широкая?</li>
          <li>Сравните длину лица (от линии роста волос до подбородка) с шириной по скулам.</li>
          <li>Посмотрите на подбородок: он округлый, угловатый или заострённый?</li>
        </ol>
        <div class="flist">{FACE_ORDER.map((f) => (
          <a class="panel fitem" href={faceUrl(f)}>
            <svg viewBox="0 0 60 80" aria-hidden="true" set:html={FACE_SVG[f]} />
            <div><h2 class="h3">{FACES[f].name} лицо</h2><ul>{FACES[f].signs.map((s) => <li>{s}</li>)}</ul></div>
          </a>
        ))}</div>
      </>
    )}

    {view === 'face' && face && (() => { const f = FACES[face]; return (
      <>
        <div class="fhead"><svg viewBox="0 0 60 80" aria-hidden="true" set:html={FACE_SVG[face]} /><div><h1>{h1}</h1><p class="lead">{f.goal}</p></div></div>
        <div class="cols">
          <div class="panel"><h2 class="h3">Как узнать {f.gen.replace(/ого$/, 'ое')} лицо</h2><ul>{f.signs.map((s) => <li>{s}</li>)}</ul></div>
          <div class="panel"><h2 class="h3">Что подходит</h2><p>{f.good}</p><h2 class="h3">Чего избегать</h2><p>{f.bad}</p></div>
        </div>
        <h2>Стрижки, которые подходят</h2>
        <div class="cuts">{forFace.map(([k, h]) => (
          <a class="cut" href={haircutUrl(k)}><img src={photoUrl(h.photo.file)} alt={h.photo.alt} width={h.photo.w} height={h.photo.h} loading="lazy" /><b>{h.name}</b><span class="muted">{h.summary}</span></a>
        ))}</div>
        {notFace.length > 0 && (<><h2>С осторожностью</h2><p>{f.bad}</p><p class="chips">{notFace.map(([k, h]) => <a class="chip" href={haircutUrl(k)}>{h.name}</a>)}</p></>)}
        <h2>Другие формы лица</h2>
        <p class="chips">{FACE_ORDER.filter((x) => x !== face).map((x) => <a class="chip" href={faceUrl(x)}>{FACES[x].name}</a>)}</p>
      </>
    ); })()}

    {view === 'cut' && c && (
      <>
        <div class="chead">
          <figure class="cph"><img src={photoUrl(c.photo.file)} alt={c.photo.alt} width={c.photo.w} height={c.photo.h} /><figcaption>{c.photo.caption} Фото: <a href={`https://unsplash.com/photos/${c.photo.id}`} rel="nofollow noopener" target="_blank">{c.photo.author}</a> / Unsplash</figcaption></figure>
          <div>
            <p class="eyebrow">{({ short: 'Короткая', medium: 'Средняя', long: 'Длинная' } as const)[c.len]} стрижка{c.aka ? ` · ${c.aka}` : ''}</p>
            <h1>{h1}</h1>
            <p class="lead">{c.summary}</p>
            <dl class="spec">
              <dt>Сверху</dt><dd>{c.top}</dd>
              <dt>Бока и затылок</dt><dd>{c.sides}</dd>
              <dt>Обновлять</dt><dd>{c.care}</dd>
              <dt>Волосы</dt><dd>{c.hair}</dd>
              <dt>Форма лица</dt><dd>{c.fits.map((f, i) => <>{i > 0 && ', '}<a href={faceUrl(f)}>{FACES[f].name.toLowerCase()}</a></>)}</dd>
            </dl>
            <a class="btn brass sm" href="/listings/">Найти барбершоп</a>
          </div>
        </div>
        <h2>Что это за стрижка</h2>
        {c.about.map((p) => <p>{p}</p>)}
        <h2>История</h2>
        {c.history.map((p) => <p>{p}</p>)}
        <h2>Кому подходит</h2>
        <p>Стрижка {c.name.toLowerCase()} подходит для лица формы: {c.fits.map((f, i) => <>{i > 0 && ', '}<a href={faceUrl(f)}>{FACES[f].name.toLowerCase()}</a></>)}.</p>
        {c.avoid.length > 0 && <p><b>С осторожностью:</b> {c.avoid.map((f) => FACES[f].name.toLowerCase()).join(', ')} лицо. {c.avoidWhy}</p>}
        <p>{c.hair}</p>
        <h2>Как объяснить барберу</h2>
        <p>{c.ask}</p>
        <h2>Как укладывать</h2>
        <ol>{c.styling.map((s) => <li>{s}</li>)}</ol>
        <p class="chips">{c.products.filter((k) => TYPES[k]).map((k) => <a class="chip" href={typeUrl(k)}>{TYPES[k].name}: как выбрать</a>)}<a class="chip" href="/kosmetika/podbor/">Подобрать средство</a></p>
        <h2>Похожие стрижки</h2>
        <div class="cuts sm">{list(c.similar).map(([k, h]) => (
          <a class="cut" href={haircutUrl(k)}><img src={photoUrl(h.photo.file)} alt={h.photo.alt} width={h.photo.w} height={h.photo.h} loading="lazy" /><b>{h.name}</b></a>
        ))}</div>
        <p><a href="/pricheski/">Все стрижки →</a></p>
      </>
    )}
  </div>
</Base>
<style>
.prc h1{margin-bottom:10px}.prc h2{margin-top:30px}.prc .panel h2,.prc .cta h2{margin-top:0}
.lead{font-size:18px;max-width:820px}
.hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:28px;align-items:center}
.hero-ph img,.cph img{width:100%;height:auto;border-radius:16px;display:block;aspect-ratio:4/5;object-fit:cover}
.hero-ph{margin:0;max-width:380px;justify-self:end}
figcaption{font-size:13px;color:var(--muted);margin-top:6px}
.faces{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10px}
.face{display:grid;justify-items:center;gap:6px;padding:14px 6px;border:1px solid var(--line);border-radius:14px;background:#fff;text-decoration:none;color:inherit;font-weight:600;font-size:14px}
.face:hover,.cut:hover,.fitem:hover{border-color:var(--brass)}
.face svg,.fitem svg,.fhead svg{width:44px;height:58px;fill:none;stroke:var(--brass);stroke-width:2.5}
.cuts{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px;margin:12px 0}
.cuts.sm{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
.cut{display:grid;gap:4px;align-content:start;text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:14px;background:#fff;padding:8px 8px 12px}
.cut img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border-radius:10px;margin-bottom:6px}
.cut b{font-size:17px;padding:0 4px}.cut span{font-size:14px;padding:0 4px}
.tbl{overflow-x:auto;margin:10px 0 18px}.tbl table{width:100%;border-collapse:collapse;min-width:640px;font-size:15px}.tbl th,.tbl td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}.tbl th{background:var(--paper)}
.cta{margin:26px 0}
.flist{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:14px;margin:16px 0}
.fitem{display:flex;gap:16px;align-items:flex-start;text-decoration:none;color:inherit}.fitem h2{margin:0 0 6px}.fitem ul{margin:0;padding-left:18px;font-size:15px}
.fhead{display:flex;gap:20px;align-items:center}.fhead svg{width:70px;height:92px;flex:none}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:16px;margin:16px 0}.cols>*{min-width:0}
.chead{display:grid;grid-template-columns:minmax(0,360px) minmax(0,1fr);gap:28px;align-items:start;margin-top:8px}
.cph{margin:0}
.spec{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin:14px 0 18px}.spec dt{color:var(--muted)}.spec dd{margin:0}
@media (max-width:820px){.hero,.chead{grid-template-columns:minmax(0,1fr)}.hero-ph{justify-self:start;max-width:100%}.faces{grid-template-columns:repeat(4,minmax(0,1fr))}.cph{max-width:420px}}
@media (max-width:480px){.faces{grid-template-columns:repeat(3,minmax(0,1fr))}.cuts{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
