---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import ShopCard from '../../components/ShopCard.astro';
import YMap from '../../components/YMap.astro';
import { sql } from '../../lib/db';
import { featureLabels, type Card } from '../../lib/catalog';
import { img, rel } from '../../lib/img';
import { breadcrumbLd, abs } from '../../lib/seo';
import { cleanHtml, strip, clip, rub, phoneHref, ensureUrl, dateRu, plural, fillAlt, shops as shopsWord } from '../../lib/text';
import { site } from '../../data/site';
import { inCity } from '../../lib/cases';
import Captcha from '../../components/Captcha.astro';
import { isPro, PRICE } from '../../lib/billing';
import '../../styles/forms.css';

const parts = (Astro.params.p || '').split('/').filter(Boolean);
if (parts.length === 0) return Astro.redirect('/listings/', 301);
if (parts.length > 1) return Astro.redirect(`/place/${parts[0]}/`, 301); // старые /place/slug/2/, вложения, ленты
const slug = parts[0];
const [s] = await sql`select b.*, b.rating::float as rating_f, l.name as city, l.path as city_path, l.parent_id as city_parent,
  c.name as chain_name, c.slug as chain_slug
  from barbershops b left join locations l on l.id = b.location_id left join chains c on c.id = b.chain_id
  where b.slug = ${slug} and b.status = 'published'`;
if (!s) {
  const [m] = await sql`select t.slug from barbershops b join barbershops t on t.id = b.merged_into and t.status = 'published' where b.slug = ${slug} and b.status = 'merged'`;
  if (m) return Astro.redirect(`/place/${m.slug}/`, 301);
  return Astro.rewrite('/404/');
}

const [metros, colls, reviews, labels, country, ycServices, ycStaff] = await Promise.all([
  sql`select m.slug, m.name from barbershop_metro bm join metro m on m.id = bm.metro_id where bm.barbershop_id = ${s.id} order by m.name`,
  sql`select c.slug, c.name from barbershop_collections bc join collections c on c.id = bc.collection_id where bc.barbershop_id = ${s.id}`,
  sql`select author_name, rating, pros, cons, content, created_at from reviews where barbershop_id = ${s.id} and status = 'published' order by created_at desc`,
  featureLabels(),
  s.city_parent ? sql`select name, path from locations where id = ${s.city_parent}`.then((r) => r[0]) : Promise.resolve(null),
  sql`select title, category, price_min::float as pmin, price_max::float as pmax from yclients_services where barbershop_id = ${s.id} order by category nulls last, price_min nulls last, title`.catch(() => []),
  sql`select name, specialization, rating::float as rating, reviews, avatar from yclients_staff where barbershop_id = ${s.id} order by rating desc nulls last, reviews desc`.catch(() => []),
]);
const ycGroups: [string, any[]][] = [];
for (const x of ycServices as any[]) {
  const k = x.category || 'Услуги';
  const g = ycGroups.find((g) => g[0] === k);
  if (g) g[1].push(x); else ycGroups.push([k, [x]]);
}
const ycDate = s.yclients_synced_at ? dateRu(s.yclients_synced_at) : null;
const near: Card[] = s.lat && s.lng
  ? await sql`select b.id, b.slug, b.title, coalesce(b.cover_image, b.gallery->>0) as cover, b.rating::float as rating, coalesce(b.reviews_count,0) as reviews_count,
      coalesce(b.closed,false) as closed, coalesce(b.featured,false) as featured, b.address, b.services->>'strizh' as price, l.name as city, l.path as city_path, b.lat, b.lng,
      (select string_agg(m.name, ', ') from barbershop_metro bm join metro m on m.id = bm.metro_id where bm.barbershop_id = b.id) as metro
      from barbershops b left join locations l on l.id = b.location_id
      where b.status = 'published' and b.id <> ${s.id} and b.lat is not null and not coalesce(b.closed,false)
      order by (b.lat - ${s.lat})^2 + ((b.lng - ${s.lng}) * cos(radians(${s.lat})))^2 limit 4`
  : [];

const gallery: string[] = [...new Set([s.cover_image, ...((s.gallery as string[]) || [])].filter((x) => rel(x)))];
const services = Object.entries((s.services || {}) as Record<string, unknown>).filter(([, v]) => v !== null && v !== '' && v !== 0)
  .map(([k, v]) => ({ label: labels[k]?.label || k, price: v })).sort((a, b) => Number(a.price) - Number(b.price));
const amenities = ((s.amenities || []) as string[]).map((k) => labels[k]?.label).filter(Boolean);
const DAYS = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
const hours = Array.isArray(s.opening_hours) ? (s.opening_hours as any[]).filter((h) => h && h.day) : [];
const sameHours = hours.length === 7 && hours.every((h) => h.from === hours[0].from && h.to === hours[0].to);
const rating = s.rating_f ? Math.round(s.rating_f * 10) / 10 : null;
const metroNames = metros.map((m) => m.name.replace(/\s*\((Мск|СПб|Спб)\)/, ''));
const descText = strip(s.description);
const strizh = s.services?.strizh ? rub(s.services.strizh) : null;
const [{ twins }] = await sql`select count(*)::int twins from barbershops where status = 'published' and location_id = ${s.location_id} and lower(title) = lower(${s.title}) and id <> ${s.id}`;
const cityRe = s.city ? new RegExp('^(г\\.?\\s*|город\\s*)?' + s.city.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*,?\\s*', 'i') : null;
const street = (cityRe ? (s.address || '').replace(cityRe, '') : s.address || '').replace(/^(г\.?|город)\s*[^,]+,\s*/i, '').split(',').slice(0, 2).join(',').trim();
const place = twins && street ? street : metroNames[0] ? `м. ${metroNames[0]}` : street;
const name = String(s.title).replace(/\s+/g, ' ').trim().slice(0, 50).replace(/\s+\S*$/, (m) => (String(s.title).replace(/\s+/g, ' ').trim().length > 50 ? '' : m));
const head = `${name} — барбершоп${s.city ? ' ' + inCity(s.city).replace(/^— /, ', ') : ''}`;
const titleCore = place && (head + ', ' + place).length <= 72 ? `${head}, ${place}` : head;
const title = s.seo_title || [': цены, отзывы, запись', ': цены и отзывы', ''].map((x) => titleCore + x).find((t) => t.length <= 75) || titleCore;
const description = clip(s.seo_description || [`${s.title} — барбершоп${s.address ? ' по адресу ' + s.address : ''}${s.city ? ', ' + s.city : ''}.`, strizh ? `Мужская стрижка — ${strizh}.` : '', descText].filter(Boolean).join(' '), 200);
const crumbs: [string, string?][] = [['Главная', '/']];
if (country) crumbs.push([country.name, `/location/${country.path}/`]);
if (s.city) crumbs.push([s.city, `/location/${s.city_path}/`]);
crumbs.push([s.title]);

// Тариф: телефон, сайт, онлайн-запись и соцсети показываем только у PRO
const pro = isPro(s);
const phone = pro ? phoneHref(s.phone) : null;
const website = pro ? ensureUrl(s.website) : null;
const booking = pro ? ensureUrl(s.booking_url) || ensureUrl(s.booking_url_alt) : null;
const socials = (pro ? [['Instagram*', ensureUrl(s.instagram)], ['ВКонтакте', ensureUrl(s.vk)], ['YouTube', ensureUrl(s.youtube)]].filter(([, u]) => u) : []) as [string, string][];
const sameAs = [website, ...socials.map(([, u]) => u)].filter(Boolean) as string[];
const ld: any = {
  '@context': 'https://schema.org', '@type': 'BarberShop', name: s.title, url: abs(`/place/${s.slug}/`),
  image: gallery.slice(0, 5).map((g) => abs(rel(g)!)), description: clip(descText, 300) || undefined, telephone: (pro && s.phone) || undefined,
  address: s.address ? { '@type': 'PostalAddress', streetAddress: s.address, addressLocality: s.city || undefined, addressCountry: country?.name || undefined } : undefined,
  geo: s.lat && s.lng ? { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng } : undefined,
  priceRange: strizh ? `от ${strizh}` : undefined,
  sameAs: sameAs.length ? sameAs : undefined,
  openingHoursSpecification: hours.length ? hours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: 'https://schema.org/' + ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][h.day - 1], opens: h.from, closes: h.to })) : undefined,
};
if (rating && reviews.length) {
  ld.aggregateRating = { '@type': 'AggregateRating', ratingValue: rating, reviewCount: reviews.length, bestRating: 5, worstRating: 1 };
  ld.review = reviews.slice(0, 5).filter((r) => r.rating).map((r) => ({ '@type': 'Review', author: { '@type': 'Person', name: r.author_name || 'Гость' }, reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 }, reviewBody: clip(strip([r.pros, r.cons, r.content].filter(Boolean).join(' ')), 500), datePublished: r.created_at ? new Date(r.created_at).toISOString().slice(0, 10) : undefined }));
}
const user = Astro.locals.user;
const [fav] = user ? await sql`select 1 from favorites where user_id = ${user.id} and barbershop_id = ${s.id}` : [];
const mine = user && (s.owner_id === user.id || ['administrator', 'editor'].includes(user.role || ''));
const reviewMsg: Record<string, [string, string]> = { ok: ['ok', 'Спасибо! Отзыв опубликуем после проверки модератором.'], dup: ['err', 'Вы уже оставляли отзыв об этом барбершопе.'], short: ['err', 'Поставьте оценку и напишите хотя бы пару предложений.'], limit: ['err', 'Слишком много отзывов подряд — попробуйте позже.'], captcha: ['err', 'Подтвердите, что вы не робот.'], error: ['err', 'Не получилось отправить отзыв. Обновите страницу и попробуйте снова.'] };
const rm = reviewMsg[Astro.url.searchParams.get('review') || ''];
const og = gallery[0] ? abs(img(gallery[0], 1200, 630)) : undefined;
---
<Base {title} {description} ogImage={og} jsonLd={[ld, breadcrumbLd(crumbs)]}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <header class="pl-head" data-view={mine ? undefined : s.id} data-mine={mine ? '1' : undefined}>
      <div class="pl-title">
        {s.closed && <span class="badge closed">Закрыт</span>}
        <h1>{s.title}</h1>
        <p class="pl-sub">
          {s.chain_name && /\p{L}/u.test(s.chain_name) && <a href={`/all/${s.chain_slug}/`} class="chip">Сеть {s.chain_name}</a>}
          {rating ? <span class="chip"><span class="stars">★</span> {rating.toFixed(1)} · {reviews.length || s.reviews_count} {plural(reviews.length || s.reviews_count || 0, 'отзыв', 'отзыва', 'отзывов')}</span> : null}
          {s.city && <a class="chip" href={`/location/${s.city_path}/`}>{s.city}</a>}
          {metros.map((m, i) => <a class="chip" href={`/metro/${m.slug}/`}>м. {metroNames[i]}</a>)}
        </p>
      </div>
      <div class="pl-actions">
        <button type="button" class={`btn ghost fav${fav ? ' on' : ''}`} data-fav={s.id} data-login={user ? '' : `/login/?next=/place/${s.slug}/`} aria-pressed={fav ? 'true' : 'false'}>{fav ? '♥ В избранном' : '♡ В избранное'}</button>
        {mine && <a class="btn ghost" href={`/edit/?id=${s.id}`}>Редактировать</a>}
      </div>
      {!s.closed && (
        <div class="pl-actions">
          {booking && <a class="btn brass" href={booking} target="_blank" rel="nofollow noopener" data-goal={site.goals.booking} data-stat="booking" data-sid={s.id}>Записаться онлайн</a>}
          {phone && <a class="btn" href={phone} data-goal={site.goals.callShop} data-stat="phone" data-sid={s.id}>{s.phone}</a>}
        </div>
      )}
    </header>
    {s.closed && <p class="pl-closed panel">Этот барбершоп закрыт. Посмотрите <a href={s.city_path ? `/location/${s.city_path}/` : '/listings/'}>другие барбершопы{s.city ? ' в городе ' + s.city : ''}</a> или ближайшие ниже.</p>}

    {gallery.length > 0 && (
      <div class="pl-gal" aria-label="Фотографии">
        {gallery.map((g, i) => (
          <a href={rel(g)} target="_blank" class={i === 0 ? 'big' : ''}>
            <img src={img(g, i === 0 ? 1000 : 500, i === 0 ? 667 : 333)} alt={`${s.title} — фото ${i + 1}`} width={i === 0 ? 1000 : 500} height={i === 0 ? 667 : 333} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" onerror="this.closest('a').remove()" />
          </a>
        ))}
      </div>
    )}

    <div class="pl-grid">
      <div class="pl-main">
        {services.length > 0 && (
          <section class="panel">
            <h2>Цены на услуги</h2>
            <ul class="pl-prices">{services.map((x) => <li><span>{x.label}</span><b>{rub(x.price)}</b></li>)}</ul>
            <p class="muted pl-note">Цены указаны владельцем барбершопа и могли измениться — уточняйте при записи.</p>
          </section>
        )}
        {ycStaff.length > 0 && (
          <section class="panel">
            <h2>Мастера</h2>
            <ul class="pl-staff">
              {ycStaff.map((m) => (
                <li>
                  {m.avatar ? <img src={m.avatar} alt={`${m.name} — ${m.specialization || 'барбер'}, ${s.title}`} width="96" height="96" loading="lazy" decoding="async" onerror="this.remove()" /> : <span class="pl-ava">{m.name.trim()[0]}</span>}
                  <div>
                    <b>{m.name}</b>
                    {m.specialization && <span class="muted"> · {m.specialization}</span>}
                    {m.rating ? <span class="pl-rate"><span class="stars">★</span> {m.rating.toFixed(1)}{m.reviews ? ` · ${m.reviews} ${plural(m.reviews, 'отзыв', 'отзыва', 'отзывов')}` : ''}</span> : null}
                  </div>
                </li>
              ))}
            </ul>
            {ycDate && <p class="muted pl-note">Состав мастеров обновлён {ycDate} из онлайн-записи.</p>}
          </section>
        )}
        {ycServices.length > 0 && (
          <section class="panel">
            <h2>Актуальные цены из онлайн-записи</h2>
            {ycGroups.map(([cat, items]) => (
              <div class="pl-ycat">
                {ycGroups.length > 1 && <h3 class="h4">{cat}</h3>}
                <ul class="pl-prices">{items.map((x: any) => <li><span>{x.title}</span><b>{x.pmin && x.pmax && x.pmin !== x.pmax ? `${rub(x.pmin)}–${rub(x.pmax)}` : rub(x.pmin || x.pmax)}</b></li>)}</ul>
              </div>
            ))}
            {ycDate && <p class="muted pl-note">Цены обновлены {ycDate} из системы онлайн-записи — итоговая стоимость зависит от выбранного мастера.</p>}
          </section>
        )}
        {s.description && (
          <section class="panel">
            <h2>О барбершопе</h2>
            <div class="prose" set:html={fillAlt(cleanHtml(s.description), s.title)} />
          </section>
        )}
        <section class="panel">
          <h2>Коротко о {s.title}</h2>
          <p>{s.title} — {s.chain_name && /\p{L}/u.test(s.chain_name) ? `барбершоп сети ${s.chain_name}` : 'барбершоп'}{s.city ? ` в городе ${s.city}` : ''}{s.address ? `, адрес: ${s.address}` : ''}{metroNames.length ? `, рядом ${metroNames.length > 1 ? 'со станциями' : 'со станцией'} метро ${metroNames.join(', ')}` : ''}.{strizh ? ` Мужская стрижка стоит ${strizh}` : ''}{services.length > 1 ? `${strizh ? ',' : ''} всего в прайсе ${services.length} ${plural(services.length, 'услуга', 'услуги', 'услуг')}` : ''}{strizh || services.length > 1 ? '.' : ''}{hours.length ? (sameHours ? ` Работает ежедневно с ${hours[0].from} до ${hours[0].to}.` : ` Работает ${hours.length} ${plural(hours.length, 'день', 'дня', 'дней')} в неделю.`) : ''}{rating && reviews.length ? ` Средняя оценка посетителей — ${rating.toFixed(1)} из 5 по ${reviews.length} ${plural(reviews.length, 'отзыву', 'отзывам', 'отзывам')}.` : ''}{amenities.length ? ` Для гостей: ${amenities.slice(0, 4).join(', ').toLowerCase()}.` : ''}</p>
          {near.length > 0 && <p class="muted">Рядом ещё {shopsWord(near.length)} — смотрите блок ниже{s.city_path ? <> или <a href={`/location/${s.city_path}/`}>все барбершопы {s.city ? inCity(s.city).replace(/^— /, '') : ''}</a></> : ''}.</p>}
        </section>
        {amenities.length > 0 && (
          <section class="panel">
            <h2>Удобства</h2>
            <ul class="pl-am">{amenities.map((a) => <li>✓ {a}</li>)}</ul>
          </section>
        )}
        <section class="panel" id="reviews">
          <h2>Отзывы{reviews.length ? ` (${reviews.length})` : ''}</h2>
          {rm && <p class={`msg ${rm[0]}`}>{rm[1]}</p>}
          {reviews.length === 0 && <p class="muted">Пока никто не оставил отзыв об этом барбершопе.</p>}
          {reviews.map((r) => (
            <article class="rv">
              <p class="rv-h"><b>{r.author_name || 'Гость'}</b>{r.rating && <span class="stars"> {'★'.repeat(r.rating)}<span style="opacity:.25">{'★'.repeat(5 - r.rating)}</span></span>}<span class="muted"> · {dateRu(r.created_at)}</span></p>
              {r.pros && <p><b>Понравилось:</b> {r.pros}</p>}
              {r.cons && <p><b>Не понравилось:</b> {r.cons}</p>}
              {r.content && <div set:html={cleanHtml(/<p/.test(r.content) ? r.content : `<p>${r.content}</p>`)} />}
            </article>
          ))}
          <details class="rv-form" open={Boolean(rm && rm[0] === 'err')}>
            <summary class="btn ghost sm">Оставить отзыв</summary>
            {user ? (
              <form method="post" action="/api/review/" class="frm">
                <input type="hidden" name="id" value={s.id} />
                <fieldset class="stars-in"><legend>Оценка</legend>{[5, 4, 3, 2, 1].map((n) => <><input type="radio" name="rating" value={n} id={`r${n}`} required /><label for={`r${n}`} title={`${n} из 5`}>★</label></>)}</fieldset>
                <label>Что понравилось <textarea class="field" name="pros" maxlength="1000" rows="3"></textarea></label>
                <label>Что не понравилось <textarea class="field" name="cons" maxlength="1000" rows="3"></textarea></label>
                <label>Комментарий <textarea class="field" name="content" maxlength="3000" rows="4"></textarea></label>
                <Captcha />
                <div><button class="btn brass">Отправить отзыв</button></div>
              </form>
            ) : <p class="alt"><a href={`/login/?next=/place/${s.slug}/%23reviews`}>Войдите</a> или <a href="/register/">зарегистрируйтесь</a>, чтобы оставить отзыв.</p>}
          </details>
        </section>
      </div>
      <aside class="pl-side">
        <div class="panel">
          <h2 class="h3">Контакты</h2>
          <dl class="pl-dl">
            {s.address && <><dt>Адрес</dt><dd>{s.address}{s.city ? `, ${s.city}` : ''}</dd></>}
            {metroNames.length > 0 && <><dt>Метро</dt><dd>{metroNames.join(', ')}</dd></>}
            {phone && !s.closed && <><dt>Телефон</dt><dd><a href={phone} data-goal={site.goals.callShop} data-stat="phone" data-sid={s.id}>{s.phone}</a></dd></>}
            {website && <><dt>Сайт</dt><dd><a href={website} target="_blank" rel="nofollow noopener" data-goal={site.goals.siteClick} data-stat="site" data-sid={s.id}>{website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></dd></>}
            {hours.length > 0 && <><dt>Часы работы</dt><dd>{sameHours ? <>Ежедневно {hours[0].from}–{hours[0].to}</> : <ul class="pl-hours">{hours.map((h) => <li><span>{DAYS[h.day - 1]}</span> {h.from && h.to ? `${h.from}–${h.to}` : 'выходной'}</li>)}</ul>}</dd></>}
          </dl>
          {socials.length > 0 && <div class="chips">{socials.map(([n, u]) => <a class="chip" href={u} target="_blank" rel="nofollow noopener" data-stat="social" data-sid={s.id}>{n}</a>)}</div>}
          {socials.some(([n]) => n.startsWith('Instagram')) && <p class="muted pl-note">* Instagram принадлежит компании Meta, деятельность которой запрещена в России.</p>}
          {!s.closed && booking && <a class="btn brass pl-wide" href={booking} target="_blank" rel="nofollow noopener" data-goal={site.goals.booking} data-stat="booking" data-sid={s.id}>Записаться онлайн</a>}
        </div>
        {s.lat && s.lng && <YMap points={[{ title: s.title, lat: s.lat, lng: s.lng, address: s.address }]} zoom={15} height={300} />}
        {mine && !pro && (
          <div class="panel upsell">
            <p class="eyebrow">Видно только вам</p>
            <p><b>Телефон, сайт и онлайн-запись скрыты</b> — на бесплатном тарифе клиенты их не видят.</p>
            <a class="btn brass pl-wide" href={`/billing/?id=${s.id}`}>Подключить PRO — {PRICE.pro} ₽/мес</a>
          </div>
        )}
        {colls.length > 0 && <div class="panel"><h2 class="h3">В подборках</h2><div class="chips">{colls.map((c) => <a class="chip" href={`/collection/${c.slug}/`}>{c.name}</a>)}</div></div>}
        {!mine && <><p class="muted pl-note">Вы владелец?</p><form action="/claim/" method="get" class="claim-f"><input type="hidden" name="id" value={s.id} /><button class="btn ghost sm">Это мой барбершоп</button></form><p class="muted pl-note">Получите доступ к карточке: фото, цены, описание.</p></>}
      </aside>
    </div>

    {near.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Барбершопы рядом</h2>{s.city_path && <a href={`/location/${s.city_path}/`} class="btn ghost sm">Все в городе {s.city}</a>}</div>
        <div class="grid">{near.map((n) => <ShopCard s={n} />)}</div>
      </section>
    )}
  </div>
  <script is:inline>
    document.querySelectorAll('[data-fav]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (b.dataset.login) { location.href = b.dataset.login; return; }
        fetch('/api/favorite/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: b.dataset.fav }) })
          .then(function (r) { return r.json(); }).then(function (j) {
            if (j.login) { location.href = '/login/'; return; }
            b.classList.toggle('on', j.fav); b.setAttribute('aria-pressed', j.fav); b.textContent = j.fav ? '♥ В избранном' : '♡ В избранное';
          });
      });
    });
