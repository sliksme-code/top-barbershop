---
import Base from '../layouts/Base.astro';
import ShopCard from '../components/ShopCard.astro';
import PostCard from '../components/PostCard.astro';
import { sql } from '../lib/db';
import { listShops, locationCounts, TRUE } from '../lib/catalog';
import { img } from '../lib/img';
import { site } from '../data/site';
import { shops } from '../lib/text';

const [top, locs, chains, colls, posts, [stat]] = await Promise.all([
  listShops(sql`b.rating is not null and coalesce(b.reviews_count,0) > 0 and b.cover_image is not null`, 1, 8),
  locationCounts(),
  sql`select c.slug, c.name, c.image, count(b.id)::int n from chains c join barbershops b on b.chain_id = c.id and b.status='published' where c.name ~ '[[:alpha:]]' group by c.id order by n desc limit 12`,
  sql`select slug, name from collections order by name`,
  sql`select slug, title, cover_image, excerpt, left(content, 600) as content, published_at from posts where status = 'published' and not coalesce(noindex,false) order by published_at desc limit 3`,
  sql`select count(*)::int shops, count(distinct location_id)::int cities from barbershops where status='published'`,
]);
const cities = locs.filter((l) => l.parent_id && l.n > 0).slice(0, 16);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: 'https://top-barbershop.com/', potentialAction: { '@type': 'SearchAction', target: 'https://top-barbershop.com/search/?q={q}', 'query-input': 'required name=q' } },
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: 'https://top-barbershop.com/', logo: 'https://top-barbershop.com/favicon.svg', sameAs: [site.social.vk] },
];
---
<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-in">
      <p class="eyebrow">Каталог с 2016 года</p>
      <h1>Барбершопы России и СНГ — найдите своего барбера</h1>
      <p class="hero-lead">{shops(stat.shops)} в {stat.cities} городах: адреса на карте, цены на стрижку и бритьё, фото и отзывы. Только мужские парикмахерские.</p>
      <form action="/search/" method="get" class="hero-search" role="search">
        <label class="sr" for="q">Что ищем</label>
        <input id="q" name="q" class="field" placeholder="Название, улица или станция метро" />
        <button class="btn brass" type="submit">Найти</button>
      </form>
      <div class="chips hero-cities">
        {cities.slice(0, 8).map((c) => <a class="chip" href={`/location/${c.path}/`}>{c.name} <span>{c.n}</span></a>)}
        <a class="chip" href="/goroda/">Все города →</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <div class="section-head"><h2>Барбершопы с лучшими отзывами</h2><a class="btn ghost sm" href="/listings/">Весь каталог</a></div>
      <div class="grid">{top.items.map((s, i) => <ShopCard s={s} eager={i < 4} />)}</div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Города</h2><a class="btn ghost sm" href="/goroda/">Все города</a></div>
      <div class="cities">
        {cities.map((c) => <a href={`/location/${c.path}/`} class="city"><b>{c.name}</b><span>{shops(c.n)}</span></a>)}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Сети барбершопов</h2><a class="btn ghost sm" href="/samye-krupnye-seti-barbershopov/">Все сети</a></div>
      <div class="chains">
        {chains.map((c) => (
          <a href={`/all/${c.slug}/`} class="chain">
            {c.image ? <img src={img(c.image, 160, 160, 'fit')} alt="" width="56" height="56" loading="lazy" onerror="this.remove()" /> : <span class="chain-l">{c.name.slice(0, 1)}</span>}
            <span><b>{c.name}</b><small>{shops(c.n)}</small></span>
          </a>
        ))}
      </div>
      {colls.length > 0 && <div class="chips" style="margin-top:18px">{colls.map((c) => <a class="chip" href={`/collection/${c.slug}/`}>{c.name}</a>)}</div>}
    </section>

    <section class="owners panel">
      <div>
        <p class="eyebrow">Для владельцев</p>
        <h2>Добавьте свой барбершоп в каталог</h2>
        <p class="muted">Карточка с ценами, фото и онлайн-записью. Клиенты ищут барбершоп у метро и по отзывам — будьте там, где вас ищут.</p>
      </div>
      <a class="btn brass" href="/owners/">Подробнее</a>
    </section>

    {posts.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Журнал</h2><a class="btn ghost sm" href="/zhurnal/">Все статьи</a></div>
        <div class="grid">{posts.map((p) => <PostCard p={p} />)}</div>
      </section>
    )}
  </div>
</Base>
<style>
.hero{background:radial-gradient(1200px 500px at 85% -10%,#3a2c18 0,transparent 60%),var(--ink);color:#f3ede4;padding:72px 0 64px}
.hero-in{max-width:var(--w)}
.hero h1{max-width:820px;color:#fff}
.hero-lead{font-size:clamp(17px,1.6vw,20px);color:#cfc6b9;max-width:680px}
.hero-search{display:flex;gap:10px;max-width:680px;margin:26px 0 18px}
.hero-search .field{flex:1;min-width:0;padding:15px 18px;font-size:17px}
.hero-cities .chip{background:#221d18;border-color:#3a332b;color:#f3ede4}
.hero-cities .chip span{color:var(--brass2)}
.hero-cities .chip:hover{border-color:var(--brass)}
.cities{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(210px,100%),1fr));gap:10px}
.city{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px;text-decoration:none;display:flex;flex-direction:column;min-width:0}
.city:hover{border-color:var(--ink)}
.city span{font-size:14px;color:var(--muted)}
.chains{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(230px,100%),1fr));gap:10px}
.chain{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px;text-decoration:none;min-width:0}
.chain:hover{border-color:var(--ink)}
.chain img,.chain-l{width:56px;height:56px;border-radius:10px;object-fit:contain;background:var(--paper);flex:none}
.chain-l{display:grid;place-items:center;font-weight:800;font-size:22px;color:var(--brass)}
.chain span{display:flex;flex-direction:column;min-width:0}
.chain small{color:var(--muted)}
.owners{display:flex;justify-content:space-between;align-items:center;gap:24px;margin:16px 0;background:var(--ink);color:#f3ede4;border:0;padding:32px}
.owners h2{color:#fff}.owners .muted{color:#b9b0a3;margin:0}
@media (max-width:640px){.hero{padding:44px 0 40px}.hero-search{flex-direction:column}.owners{flex-direction:column;align-items:flex-start}}
</style>
