---
import Listing from '../../components/Listing.astro';
import { sql } from '../../lib/db';
import { listShops, mapPoints, splitPage } from '../../lib/catalog';
import { shops, clip } from '../../lib/text';
const { parts, page } = splitPage(Astro.params.p);
if (parts.length !== 1) return Astro.rewrite('/404/');
const [m] = await sql`select * from metro where slug = ${parts[0]}`;
if (!m) return Astro.rewrite('/404/');
const where = sql`b.id in (select barbershop_id from barbershop_metro where metro_id = ${m.id})`;
const data = await listShops(where, page);
if (page > data.pages && data.total) return Astro.rewrite('/404/');
const points = page === 1 ? await mapPoints(where) : [];
const name = m.name.replace(/\s*\((Мск|СПб|Спб)\)/, '');
const city = /Мск/.test(m.name) ? ['Москва', '/location/russia/msk/'] : /СПб|Спб/i.test(m.name) ? ['Санкт-Петербург', '/location/russia/spb/'] : null;
const crumbs: [string, string?][] = [['Главная', '/']];
if (city) crumbs.push([city[0], city[1]]);
crumbs.push([`м. ${name}`]);
---
<Listing h1={`Барбершопы у метро ${name}`} title={`Барбершопы у метро ${name}${city ? ' (' + city[0] + ')' : ''} — адреса, цены, отзывы`}
  description={clip(`${shops(data.total)} рядом со станцией метро ${name}${city ? ', ' + city[0] : ''}: мужские стрижки, бритьё, оформление бороды. Цены, фото, отзывы и онлайн-запись.`, 200)}
  {crumbs} base={`/metro/${m.slug}/`} {page} {data} {points} noindex={data.total === 0} eyebrow={city?.[0]} />
