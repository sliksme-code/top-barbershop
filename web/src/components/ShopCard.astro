---
import { img } from '../lib/img';
import { rub } from '../lib/text';
import type { Card } from '../lib/catalog';
const { s, eager = false } = Astro.props as { s: Card; eager?: boolean };
const r = s.rating ? Math.round(s.rating * 10) / 10 : null;
---
<article class={`card${s.closed ? ' is-closed' : ''}`}>
  <a href={`/place/${s.slug}/`} class="card-img">
    <img src={img(s.cover, 600, 400)} alt={s.title} width="600" height="400" loading={eager ? 'eager' : 'lazy'} decoding="async" onerror="this.onerror=null;this.src='/placeholder.svg'" />
    {s.closed ? <span class="badge closed">Закрыт</span> : s.featured ? <span class="badge top">Рекомендуем</span> : null}
  </a>
  <div class="card-body">
    <h3><a href={`/place/${s.slug}/`}>{s.title}</a></h3>
    <p class="card-loc">{[s.city, s.metro ? 'м. ' + s.metro.replace(/\s*\((Мск|СПб|Спб)\)/g, '') : null].filter(Boolean).join(' · ')}</p>
    {s.address && <p class="card-addr">{s.address}</p>}
    <div class="card-meta">
      {r ? <span><span class="stars">★</span> {r.toFixed(1)}{s.reviews_count ? <span class="muted"> ({s.reviews_count})</span> : null}</span> : <span class="muted">Нет оценок</span>}
      {s.price && <span class="card-price">стрижка {rub(s.price)}</span>}
    </div>
  </div>
</article>
<style>
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s,transform .2s;min-width:0}
.card:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.card-img{position:relative;display:block;aspect-ratio:3/2;background:#2a2520}
.card-img img{width:100%;height:100%;object-fit:cover}
.card-img .badge{position:absolute;left:12px;top:12px}
.is-closed .card-img img{filter:grayscale(1);opacity:.7}
.card-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:4px;flex:1}
.card h3{margin:0;font-size:17px}
.card h3 a{text-decoration:none}.card h3 a:hover{color:var(--red)}
.card-loc{margin:0;font-size:14px;color:var(--brass);font-weight:600;overflow-wrap:anywhere}
.card-addr{margin:0;font-size:14px;color:var(--muted)}
.card-meta{margin-top:auto;padding-top:10px;display:flex;justify-content:space-between;gap:8px;font-size:14px;flex-wrap:wrap}
.card-price{font-weight:650}
</style>
