---
const { light = true, width = 120 } = Astro.props;
const src = light ? '/logos/topbs-logo-white.svg' : '/logos/topbs-logo.svg';
const height = Math.round(width * 383 / 980);
---
<span class="logo">
  <img src={src} width={width} height={height} alt="TOP BARBERSHOP" loading="eager" decoding="async" />
</span>
<style>
.logo{display:inline-flex;align-items:center}
.logo img{display:block}
</style>
