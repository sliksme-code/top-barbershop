---
// Яндекс Карты: точки барбершопов. Ключ — из окружения (бесплатный тариф, см. план).
const { points, zoom = 11, height } = Astro.props as { points: { slug?: string; title: string; lat: number; lng: number; address?: string | null }[]; zoom?: number; height?: number };
const key = process.env.YANDEX_MAPS_KEY || '';
const data = points.filter((p) => p.lat && p.lng && Math.abs(p.lat) <= 90).map((p) => [p.lat, p.lng, p.title, p.slug || '', p.address || '']);
---
{data.length > 0 && (
  <div class="map" data-ymap={JSON.stringify(data)} data-zoom={zoom} style={height ? `height:${height}px` : undefined}></div>
)}
{data.length > 0 && (
  <script is:inline define:vars={{ key }}>
    (function () {
      var els = document.querySelectorAll('[data-ymap]:not([data-done])');
      if (!els.length) return;
      function init() {
        els.forEach(function (el) {
          el.setAttribute('data-done', '1');
          var pts = JSON.parse(el.getAttribute('data-ymap'));
          var map = new ymaps.Map(el, { center: [pts[0][0], pts[0][1]], zoom: +el.getAttribute('data-zoom') || 11, controls: ['zoomControl', 'fullscreenControl'] }, { suppressMapOpenBlock: true });
          map.behaviors.disable('scrollZoom');
          var c = new ymaps.Clusterer({ preset: 'islands#blackClusterIcons', groupByCoordinates: false });
          c.add(pts.map(function (p) {
            var body = (p[4] ? p[4] + '<br>' : '') + (p[3] ? '<a href="/place/' + p[3] + '/">Подробнее →</a>' : '');
            return new ymaps.Placemark([p[0], p[1]], { balloonContentHeader: p[2], balloonContentBody: body, hintContent: p[2] }, { preset: 'islands#redDotIcon' });
          }));
          map.geoObjects.add(c);
          if (pts.length > 1) map.setBounds(c.getBounds(), { checkZoomRange: true, zoomMargin: 30 });
        });
      }
      function load() {
        if (window.ymaps) return ymaps.ready(init);
        var s = document.createElement('script');
        s.src = 'https://api-maps.yandex.ru/2.1/?lang=ru_RU' + (key ? '&apikey=' + key : '');
        s.onload = function () { ymaps.ready(init); };
        document.head.appendChild(s);
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); load(); } }, { rootMargin: '300px' });
        els.forEach(function (el) { io.observe(el); });
      } else load();
    })();
  </script>
)}
