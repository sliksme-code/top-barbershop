---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, isProdHost } from '../data/site';
const isProduction = isProdHost(Astro.url);

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title = site.defaultTitle, description = site.defaultDescription, ogImage = site.ogImage, noindex = false, jsonLd } = Astro.props;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogAbs = /^https?:/.test(ogImage) ? ogImage : new URL(ogImage, Astro.site).href;
// На тестовом домене — noindex всегда
const robots = !isProduction || noindex ? 'noindex, nofollow' : 'index, follow';
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const metrikaId = site.metrikaId;
---
<!doctype html>
<html lang="ru-RU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="yandex-verification" content={site.verification.yandex} />
    <meta name="google-site-verification" content={site.verification.google} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.ogSiteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <link rel="alternate" type="application/rss+xml" title="TOP BARBERSHOP — Журнал" href="/feed/" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    {isProduction && (
      <script is:inline define:vars={{ metrikaId }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        ym(metrikaId, "init", { ssr: true, webvisor: true, clickmap: true, accurateTrackBounce: true, trackLinks: true });
      </script>
    )}
  </head>
  <body>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline define:vars={{ metrikaId }}>
      // Цели Метрики: data-goal на ссылках/кнопках (те же идентификаторы, что на старом сайте)
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-goal]');
        if (el && window.ym) window.ym(metrikaId, 'reachGoal', el.getAttribute('data-goal'));
      });
    </script>
    {isProduction && (
      <noscript><div><img src={`https://mc.yandex.ru/watch/${metrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    )}
  </body>
</html>
